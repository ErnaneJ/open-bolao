<% matches_by_stage = matches.group_by(&:stage) %>
<% if matches.empty? %>
  <div class="card p-12 text-center">
    <div class="text-4xl mb-3">📅</div>
    <p class="text-pitch-400 dark:text-pitch-400 font-medium">Nenhum jogo disponível.</p>
  </div>
<% else %>
  <div class="space-y-6">
    <% matches_by_stage.each do |stage, stage_matches| %>
      <div>
        <% if stage %>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-[10px] font-bold uppercase tracking-widest text-pitch-400 dark:text-pitch-500">
              <%= stage.name %>
            </span>
            <div class="flex-1 h-px bg-pitch-100 dark:bg-pitch-700/50"></div>
          </div>
        <% end %>
        <div class="space-y-2">
          <% stage_matches.each do |match| %>
            <% tip = tips_map[match.id] %>
            <%= turbo_frame_tag "tip_#{match.id}" do %>
              <%= render "tips/tip", match: match, tip: tip, pool: pool,
                    participant_tips_by_match: (defined?(participant_tips_by_match) ? participant_tips_by_match : {}),
                    tip_counts_by_match: (defined?(tip_counts_by_match) ? tip_counts_by_match : {}) %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
