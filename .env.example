# ── Banco de dados ────────────────────────────────────────────────────────────
# Senha do PostgreSQL (usada pelo compose e pela DATABASE_URL)
POSTGRES_PASSWORD=troque_por_senha_forte

# ── Rails ─────────────────────────────────────────────────────────────────────
# Gere com: docker run --rm ruby:4.0.5-slim ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
SECRET_KEY_BASE=gere_e_cole_aqui

# ── App ───────────────────────────────────────────────────────────────────────
# Host público usado em links de e-mail (Devise, notificações).
# Exemplos: "192.168.1.10:3000" | "bolao.casaos.local" | "meudominio.com"
APP_HOST=IP_DO_CASAOS:3000

# Porta exposta no host (default 3000)
APP_PORT=3000

# ── Seeds (criados na primeira inicialização) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@bolao.local
SEED_ADMIN_PASSWORD=troque_esta_senha!

# ── E-mail SMTP (opcional; sem isso Devise não envia emails) ──────────────────
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@email.com
# SMTP_PASSWORD=sua_senha_de_app
# SMTP_FROM=noreply@bolao.local
