<div class="space-y-5">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="form-label">Nome completo</label>
      <%= f.text_field :name, class: "form-input" %>
    </div>
    <div>
      <label class="form-label">Nome curto (até 10 chars)</label>
      <%= f.text_field :short_name, maxlength: 10, class: "form-input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    <div>
      <label class="form-label">Código do país</label>
      <%= f.text_field :country_code, maxlength: 3, class: "form-input uppercase", placeholder: "BRA" %>
    </div>
    <div>
      <label class="form-label">Gênero</label>
      <%= f.text_field :gender, placeholder: "Male / Female", class: "form-input" %>
    </div>
    <div>
      <label class="form-label">Ano fundação</label>
      <%= f.number_field :formed_year, placeholder: "1900", class: "form-input" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="form-label">Estádio</label>
      <%= f.text_field :stadium_name, class: "form-input" %>
    </div>
    <div>
      <label class="form-label">Cor principal (hex)</label>
      <%= f.text_field :primary_color, placeholder: "#1a2848", class: "form-input font-mono" %>
    </div>
  </div>

  <div>
    <label class="form-label">Website</label>
    <%= f.url_field :website, placeholder: "https://...", class: "form-input font-mono" %>
  </div>

  <div>
    <label class="form-label">Descrição</label>
    <%= f.text_area :description, rows: 3, class: "form-input resize-none" %>
  </div>

  <%# Images %>
  <div class="border-t border-pitch-100 dark:border-pitch-700 pt-4">
    <p class="form-label mb-3">Imagens</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-[11px] text-pitch-400 mb-1">Logo / Badge URL (TheSportsDB strBadge)</label>
        <%= f.url_field :logo_url, placeholder: "https://...", class: "form-input font-mono text-xs" %>
        <% if f.object.logo_url.present? %>
          <img src="<%= f.object.logo_url %>" class="h-10 mt-2 object-contain" alt="" onerror="this.style.display='none'">
        <% end %>
      </div>
      <div>
        <label class="block text-[11px] text-pitch-400 mb-1">Bandeira / Flag URL</label>
        <%= f.url_field :flag_url, placeholder: "https://...", class: "form-input font-mono text-xs" %>
        <% if f.object.flag_url.present? %>
          <img src="<%= f.object.flag_url %>" class="h-6 mt-2 object-contain" alt="" onerror="this.style.display='none'">
        <% end %>
      </div>
      <div>
        <label class="block text-[11px] text-pitch-400 mb-1">Banner URL</label>
        <%= f.url_field :banner_url, placeholder: "https://...", class: "form-input font-mono text-xs" %>
      </div>
    </div>
  </div>

  <%# External provider %>
  <div class="border-t border-pitch-100 dark:border-pitch-700 pt-4">
    <p class="form-label mb-3">Identificadores externos</p>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-[11px] text-pitch-400 mb-1">ID do provedor</label>
        <%= f.text_field :external_provider_id, class: "form-input font-mono" %>
      </div>
      <div>
        <label class="block text-[11px] text-pitch-400 mb-1">Nome do provedor</label>
        <%= f.text_field :external_provider_name, placeholder: "thesportsdb", class: "form-input font-mono" %>
      </div>
    </div>
  </div>

  <%# Upload logo (ActiveStorage) %>
  <div>
    <label class="form-label">Upload de logo (ActiveStorage)</label>
    <%= f.file_field :logo, accept: "image/*", class: "text-sm text-pitch-500 file:mr-3 file:btn file:btn-ghost file:btn-sm file:cursor-pointer" %>
  </div>
</div>
