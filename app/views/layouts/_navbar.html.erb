<nav class="fixed top-0 left-0 right-0 z-40 h-16 border-b border-pitch-100 dark:border-pitch-800 bg-white/90 dark:bg-pitch-950/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-full flex items-center justify-between gap-4">

    <%# Logo %>
    <div class="flex items-center gap-6">
      <%= link_to dashboard_path, class: "flex items-center gap-2 shrink-0" do %>
        <span class="w-8 h-8 rounded-lg bg-pitch-900 dark:bg-neon-400 flex items-center justify-center text-white dark:text-pitch-900 text-sm font-display font-bold">B</span>
        <span class="font-display font-bold text-lg text-pitch-900 dark:text-white hidden sm:block tracking-tight">Open<span class="text-neon-500 dark:text-neon-300">Bolão</span></span>
      <% end %>
      <%= link_to "Bolões", pools_path, class: "nav-link text-sm hidden md:flex" %>
    </div>

    <%# Right side %>
    <div class="flex items-center gap-1">

      <%# Dark mode %>
      <button data-controller="dark-mode" data-action="click->dark-mode#toggle"
              class="p-2.5 rounded-xl text-pitch-500 dark:text-pitch-300 hover:bg-pitch-100 dark:hover:bg-pitch-800 transition-colors"
              aria-label="Toggle dark mode">
        <svg class="hidden dark:block w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
        <svg class="dark:hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
      </button>

      <%# Notifications %>
      <% unread_count = current_user.notifications.where(read_at: nil).count %>
      <%= link_to notifications_path,
            class: "relative p-2.5 rounded-xl text-pitch-500 dark:text-pitch-300 hover:bg-pitch-100 dark:hover:bg-pitch-800 transition-colors",
            aria: { label: "Notificações" } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <% if unread_count > 0 %>
          <span id="notification-badge"
                class="absolute top-1.5 right-1.5 w-4 h-4 bg-neon-400 text-pitch-900 text-[9px] font-bold rounded-full flex items-center justify-center leading-none">
            <%= unread_count > 9 ? "9+" : unread_count %>
          </span>
        <% end %>
      <% end %>

      <%# User dropdown %>
      <div class="relative" data-controller="dropdown">
        <button data-action="click->dropdown#toggle"
                class="flex items-center gap-2.5 px-2 py-1.5 rounded-xl hover:bg-pitch-100 dark:hover:bg-pitch-800 transition-colors ml-1">
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar.variant(resize_to_fill: [32, 32]),
                  class: "avatar-sm" %>
          <% else %>
            <div class="avatar-sm bg-pitch-900 dark:bg-pitch-600 text-[11px]">
              <%= current_user.display_name.first.upcase %>
            </div>
          <% end %>
          <span class="hidden sm:block text-sm font-medium text-pitch-700 dark:text-pitch-200 max-w-24 truncate">
            <%= current_user.display_name %>
          </span>
          <svg class="w-3.5 h-3.5 text-pitch-400 hidden sm:block" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>

        <div data-dropdown-target="menu"
             class="hidden absolute right-0 mt-2 w-52 card shadow-xl shadow-pitch-900/10 dark:shadow-black/40 py-1.5 z-50 animate-enter">
          <div class="px-4 py-2 border-b border-pitch-100 dark:border-pitch-700 mb-1">
            <p class="text-xs font-semibold text-pitch-900 dark:text-white truncate"><%= current_user.display_name %></p>
            <p class="text-xs text-pitch-400 truncate"><%= current_user.email %></p>
          </div>
          <%= link_to profile_path, class: "flex items-center gap-2.5 px-4 py-2 text-sm text-pitch-700 dark:text-pitch-200 hover:bg-pitch-50 dark:hover:bg-pitch-700 transition-colors" do %>
            <svg class="w-4 h-4 text-pitch-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Meu Perfil
          <% end %>
          <% if current_user.role_admin? || current_user.role_super_admin? %>
            <%= link_to admin_pools_path, class: "flex items-center gap-2.5 px-4 py-2 text-sm text-pitch-700 dark:text-pitch-200 hover:bg-pitch-50 dark:hover:bg-pitch-700 transition-colors" do %>
              <svg class="w-4 h-4 text-pitch-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Admin
            <% end %>
          <% end %>
          <% if current_user.role_super_admin? %>
            <%= link_to super_admin_users_path, class: "flex items-center gap-2.5 px-4 py-2 text-sm text-pitch-700 dark:text-pitch-200 hover:bg-pitch-50 dark:hover:bg-pitch-700 transition-colors" do %>
              <svg class="w-4 h-4 text-pitch-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Super Admin
            <% end %>
          <% end %>
          <div class="border-t border-pitch-100 dark:border-pitch-700 my-1"></div>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
                class: "flex items-center gap-2.5 px-4 py-2 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Sair
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>
