<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= cookies[:dark_mode] == 'true' ? 'dark' : '' %>">
  <head>
    <title><%= content_for(:title).presence || "Admin — #{t('app.name')}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#070e22">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen antialiased bg-pitch-50 dark:bg-pitch-950 text-pitch-900 dark:text-pitch-50">

    <%# Top navbar %>
    <nav class="fixed top-0 left-0 right-0 z-40 h-14 border-b border-pitch-200 dark:border-pitch-800 bg-white/90 dark:bg-pitch-900/90 backdrop-blur-md">
      <div class="px-4 h-full flex items-center gap-3">
        <button data-controller="sidebar" data-action="click->sidebar#toggle"
                class="lg:hidden p-2 rounded-lg text-pitch-500 hover:bg-pitch-100 dark:hover:bg-pitch-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <span class="font-display font-bold text-base text-pitch-900 dark:text-white">
          OpenBolão <span class="text-xs font-sans font-normal text-pitch-400 ml-1">Admin</span>
        </span>
        <div class="ml-auto flex items-center gap-2">
          <button data-controller="dark-mode" data-action="click->dark-mode#toggle"
                  class="p-2 rounded-lg text-pitch-500 hover:bg-pitch-100 dark:hover:bg-pitch-800">
            <svg class="hidden dark:block w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            <svg class="dark:hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          </button>
          <%= link_to dashboard_path, class: "text-xs text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200 transition-colors" do %>← Voltar ao site<% end %>
        </div>
      </div>
    </nav>

    <div class="pt-14 flex min-h-screen" data-controller="sidebar" data-sidebar-open-value="false">

      <%# Overlay for mobile %>
      <div data-sidebar-target="overlay"
           class="fixed inset-0 z-30 bg-pitch-950/60 backdrop-blur-sm lg:hidden hidden"
           data-action="click->sidebar#close"></div>

      <%# Sidebar %>
      <aside data-sidebar-target="sidebar"
             class="fixed left-0 top-14 bottom-0 z-30 w-56 bg-white dark:bg-pitch-900 border-r border-pitch-200 dark:border-pitch-800 overflow-y-auto transition-transform duration-200 -translate-x-full lg:translate-x-0">
        <nav class="p-3 space-y-0.5">
          <p class="sidebar-section">Bolões</p>
          <%= link_to admin_pools_path, class: "sidebar-link #{request.path.start_with?('/admin/pools') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            Meus Bolões
          <% end %>
          <p class="sidebar-section">Jogos avulsos</p>
          <%= link_to admin_matches_path, class: "sidebar-link #{request.path.start_with?('/admin/matches') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Jogos
          <% end %>
          <p class="sidebar-section">Sync & Webhooks</p>
          <%= link_to admin_sync_schedules_path, class: "sidebar-link #{request.path.start_with?('/admin/sync') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Sincronização
          <% end %>
          <%= link_to admin_webhook_endpoints_path, class: "sidebar-link #{request.path.start_with?('/admin/webhook') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            Webhooks
          <% end %>
        </nav>
      </aside>

      <%# Main content %>
      <main class="flex-1 lg:ml-56 min-w-0 p-6">
        <% if notice %>
          <div class="flash-success rounded-xl px-4 py-3 text-sm mb-4 animate-enter"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="flash-error rounded-xl px-4 py-3 text-sm mb-4 animate-enter"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>

  </body>
</html>
