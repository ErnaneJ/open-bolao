<% _next_match = local_assigns[:next_match] %>
<%
  all_days = matches
    .group_by { |m| m.scheduled_at&.in_time_zone("America/Sao_Paulo")&.to_date }
    .sort_by { |d, _| d || Date::Infinity }
%>

<div data-controller="match-filter">

  <%# ── Filter bar ─────────────────────────────────────────────────────────── %>
  <div class="flex items-center gap-2 mb-5">
    <% [
      ["upcoming", "Próximos"],
      ["finished", "Encerrados"],
      ["all",      "Todos"]
    ].each_with_index do |(filter, label), i| %>
      <button data-match-filter-target="btn"
              data-filter="<%= filter %>"
              data-action="click->match-filter#setFilter"
              class="filter-pill <%= i == 0 ? 'filter-pill-active' : '' %>">
        <%= label %>
      </button>
    <% end %>
  </div>

  <%# ── Days ───────────────────────────────────────────────────────────────── %>
  <% if matches.empty? %>
    <div class="card p-12 text-center">
      <div class="text-4xl mb-3">📅</div>
      <p class="text-pitch-400 font-medium">Nenhum jogo disponível.</p>
    </div>
  <% else %>
    <div class="space-y-8">
      <% all_days.each do |date, day_matches| %>
        <%
          all_finished = day_matches.all? { |m| m.status_finished? || m.status_cancelled? }
          has_live     = day_matches.any?(&:status_live?)
          day_open     = day_matches.any? { |m| !m.status_finished? && !m.status_cancelled? }
        %>
        <div data-match-filter-target="day"
             data-date="<%= date&.iso8601 %>"
             data-all-finished="<%= all_finished %>"
             data-has-live="<%= has_live %>">
          <%= render "tips/match_day",
                date: date, day_matches: day_matches,
                pool: pool, tips_map: tips_map,
                participant_tips_by_match: (defined?(participant_tips_by_match) ? participant_tips_by_match : {}),
                tip_counts_by_match: (defined?(tip_counts_by_match) ? tip_counts_by_match : {}),
                next_match: _next_match,
                default_open: day_open %>
        </div>
      <% end %>

      <div data-match-filter-target="empty" hidden
           class="card p-12 text-center">
        <div class="text-4xl mb-3">🔍</div>
        <p class="text-pitch-400 font-medium text-sm">Nenhum jogo encontrado para este filtro.</p>
      </div>
    </div>
  <% end %>

</div>
