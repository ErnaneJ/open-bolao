<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <style>@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&amp;family=DM+Sans:wght@400;500;600&amp;display=swap');</style>
    <radialGradient id="glow" cx="50%" cy="0%" rx="60%" ry="50%">
      <stop offset="0%" stop-color="#b8ff3c" stop-opacity="0.08"/>
      <stop offset="100%" stop-color="#b8ff3c" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
      <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#ffffff" stroke-width="0.5" stroke-opacity="0.02"/>
    </pattern>
    <clipPath id="nameClip">
      <rect x="100" y="0" width="1000" height="630"/>
    </clipPath>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="#04091a"/>
  <rect width="1200" height="630" fill="url(#grid)"/>
  <ellipse cx="600" cy="-20" rx="700" ry="400" fill="url(#glow)"/>

  <!-- Left neon accent bar -->
  <rect x="0" y="0" width="6" height="630" fill="#b8ff3c" opacity="0.7"/>

  <!-- Top label -->
  <text x="80" y="82"
        font-family="'DM Sans', sans-serif"
        font-size="13" font-weight="600"
        fill="#b8ff3c" opacity="0.8"
        letter-spacing="4">VOC&#xCA; FOI CONVIDADO PARA</text>

  <!-- Pool name (large, bold) — clipped to avoid overflow -->
  <% pool_name = @pool.name.upcase %>
  <% font_size = pool_name.length <= 14 ? 110 : pool_name.length <= 22 ? 80 : pool_name.length <= 32 ? 60 : 48 %>
  <text x="80" y="<%= 170 + (font_size * 0.1).to_i %>"
        font-family="'Syne', sans-serif"
        font-size="<%= font_size %>" font-weight="800"
        fill="#ffffff"
        clip-path="url(#nameClip)"
        letter-spacing="-2"><%= h(pool_name) %></text>

  <% if @pool.description.present? %>
    <text x="80" y="310"
          font-family="'DM Sans', sans-serif"
          font-size="22" font-weight="400"
          fill="#5a74a8"><%= h(@pool.description.truncate(72)) %></text>
  <% end %>

  <!-- Stats row -->
  <% stats_y = @pool.description.present? ? 400 : 360 %>

  <!-- Participants -->
  <rect x="80" y="<%= stats_y %>" width="240" height="90" rx="16" fill="#0c152e" stroke="#1a2848" stroke-width="1.5"/>
  <text x="200" y="<%= stats_y + 36 %>"
        font-family="'Syne', sans-serif"
        font-size="38" font-weight="800"
        fill="#ffffff"
        text-anchor="middle"><%= @pool.pool_participants.active.count %></text>
  <text x="200" y="<%= stats_y + 60 %>"
        font-family="'DM Sans', sans-serif"
        font-size="13" font-weight="500"
        fill="#5a74a8"
        text-anchor="middle"
        letter-spacing="2">PARTICIPANTES</text>

  <!-- Type -->
  <rect x="340" y="<%= stats_y %>" width="200" height="90" rx="16" fill="#0c152e" stroke="#1a2848" stroke-width="1.5"/>
  <text x="440" y="<%= stats_y + 36 %>"
        font-family="'Syne', sans-serif"
        font-size="28" font-weight="800"
        fill="#ffffff"
        text-anchor="middle"><%= @pool.pool_scope_tournament? ? "TORNEIO" : "JOGO" %></text>
  <text x="440" y="<%= stats_y + 60 %>"
        font-family="'DM Sans', sans-serif"
        font-size="13" font-weight="500"
        fill="#5a74a8"
        text-anchor="middle"
        letter-spacing="2">TIPO</text>

  <!-- Status -->
  <rect x="560" y="<%= stats_y %>" width="200" height="90" rx="16"
        fill="<%= @pool.status_open? ? 'rgba(16,185,129,0.12)' : 'rgba(90,116,168,0.15)' %>"
        stroke="<%= @pool.status_open? ? 'rgba(52,211,153,0.3)' : 'rgba(90,116,168,0.3)' %>"
        stroke-width="1.5"/>
  <text x="660" y="<%= stats_y + 36 %>"
        font-family="'Syne', sans-serif"
        font-size="26" font-weight="800"
        fill="<%= @pool.status_open? ? '#34d399' : '#8ea0c8' %>"
        text-anchor="middle"><%= @pool.status_open? ? "ABERTO" : "ENCERRADO" %></text>
  <text x="660" y="<%= stats_y + 60 %>"
        font-family="'DM Sans', sans-serif"
        font-size="13" font-weight="500"
        fill="#5a74a8"
        text-anchor="middle"
        letter-spacing="2">STATUS</text>

  <!-- Admin info -->
  <text x="80" y="<%= stats_y + 128 %>"
        font-family="'DM Sans', sans-serif"
        font-size="16" font-weight="400"
        fill="#3a4f80">Admin: <tspan fill="#8ea0c8" font-weight="600"><%= h(@pool.admin.display_name) %></tspan></text>

  <!-- Bottom right branding -->
  <rect x="1046" y="566" width="106" height="32" rx="16" fill="#b8ff3c"/>
  <text x="1099" y="587"
        font-family="'Syne', sans-serif"
        font-size="14" font-weight="800"
        fill="#04091a"
        text-anchor="middle">OpenBol&#xE3;o</text>
</svg>
