<% content_for :title, @user.display_name %>
<div class="p-6 max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Usuários", super_admin_users_path, class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-2xl font-bold"><%= @user.display_name %></h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 space-y-3">
    <div class="flex justify-between"><span class="text-sm text-gray-500">Email</span><span class="text-sm font-medium"><%= @user.email %></span></div>
    <div class="flex justify-between"><span class="text-sm text-gray-500">Role</span><%= role_badge(@user.role) %></div>
    <div class="flex justify-between"><span class="text-sm text-gray-500">Cadastro</span><span class="text-sm"><%= l(@user.created_at, format: :default) %></span></div>
    <div class="flex justify-between"><span class="text-sm text-gray-500">Confirmado</span><span class="text-sm"><%= @user.confirmed_at ? "Sim" : "Não" %></span></div>
    <div class="pt-3 flex gap-3 flex-wrap">
      <%= link_to "Editar", edit_super_admin_user_path(@user), class: "px-3 py-1.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700" %>
      <%= button_to "Impersonar", impersonate_super_admin_user_path(@user), method: :post, class: "px-3 py-1.5 bg-yellow-100 text-yellow-800 rounded-lg text-sm hover:bg-yellow-200" %>
      <%= button_to "Excluir", super_admin_user_path(@user), method: :delete,
          data: { turbo_confirm: "Excluir #{@user.display_name}? Esta ação é irreversível." },
          class: "px-3 py-1.5 text-red-600 border border-red-200 rounded-lg text-sm hover:bg-red-50" %>
    </div>
  </div>
</div>
