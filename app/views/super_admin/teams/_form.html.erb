<div class="space-y-4">
  <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nome</label>
    <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %></div>
  <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nome curto (3 letras)</label>
    <%= f.text_field :short_name, maxlength: 3, class: "w-24 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %></div>
  <div><label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Código do país (3 letras)</label>
    <%= f.text_field :country_code, maxlength: 3, class: "w-24 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %></div>
</div>
