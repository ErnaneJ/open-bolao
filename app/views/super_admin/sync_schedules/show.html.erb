<% content_for :title, "Sync Schedule — #{@tournament.name}" %>
<div class="max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@tournament.name}", super_admin_tournament_path(@tournament), class: "text-sm text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200" %>
    <h1 class="font-display font-bold text-xl text-pitch-900 dark:text-white">Sincronização</h1>
    <div class="ml-auto flex gap-2">
      <%= link_to "Configurar", edit_super_admin_tournament_sync_schedule_path(@tournament), class: "btn btn-ghost btn-sm" %>
      <%= button_to "Forçar sync agora", force_run_super_admin_tournament_sync_schedule_path(@tournament), method: :post, class: "btn btn-neon btn-sm" %>
    </div>
  </div>

  <div class="card p-5 mb-6">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-2.5 h-2.5 rounded-full <%= @schedule.paused_until&.future? ? 'bg-amber-400' : @schedule.enabled? ? 'bg-grass-500' : 'bg-pitch-300' %>"></div>
      <span class="font-semibold text-pitch-900 dark:text-white">
        <%= @schedule.paused_until&.future? ? "Pausado até #{l(@schedule.paused_until, format: :short)}" : @schedule.enabled? ? "Ativo" : "Desativado" %>
      </span>
    </div>
    <div class="grid grid-cols-2 gap-4 text-sm text-pitch-500 dark:text-pitch-400">
      <div><span class="font-medium text-pitch-700 dark:text-pitch-200">Intervalo:</span> <%= @schedule.interval_seconds / 60 %> min</div>
      <div><span class="font-medium text-pitch-700 dark:text-pitch-200">Janela:</span> <%= @schedule.active_from&.strftime("%H:%M") %> – <%= @schedule.active_until&.strftime("%H:%M") %></div>
      <div><span class="font-medium text-pitch-700 dark:text-pitch-200">Último sync:</span> <%= @schedule.last_run_at ? time_ago_in_words(@schedule.last_run_at) + " atrás" : "nunca" %></div>
      <div><span class="font-medium text-pitch-700 dark:text-pitch-200">Falhas consecutivas:</span> <%= @schedule.consecutive_failures %></div>
    </div>
    <% if @schedule.last_error_message.present? %>
      <p class="mt-3 text-xs text-red-500 p-2 bg-red-50 dark:bg-red-900/20 rounded-lg"><%= @schedule.last_error_message %></p>
    <% end %>
  </div>

  <h2 class="font-display font-bold text-sm uppercase tracking-widest text-pitch-400 mb-3">Histórico de logs</h2>
  <% if @logs.any? %>
    <div class="card overflow-hidden divide-y divide-pitch-100 dark:divide-pitch-700/30">
      <% @logs.each do |log| %>
        <div class="px-4 py-3 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="<%= log.status_success? ? 'text-grass-500' : 'text-red-500' %> text-sm font-bold">
              <%= log.status_success? ? "✓" : "✗" %>
            </span>
            <div>
              <p class="text-sm font-mono text-pitch-700 dark:text-pitch-200">
                <%= log.started_at.strftime("%d/%m/%y %H:%M:%S") %>
              </p>
              <% if log.error_message.present? %>
                <p class="text-xs text-red-400"><%= log.error_message.truncate(80) %></p>
              <% end %>
            </div>
          </div>
          <div class="text-right text-xs text-pitch-400">
            <div><%= log.matches_checked %> verificados</div>
            <div><%= log.matches_updated %> atualizados</div>
          </div>
        </div>
      <% end %>
    </div>
    <%= render "shared/pagy", pagy: @pagy %>
  <% else %>
    <div class="card p-8 text-center">
      <p class="text-pitch-400">Nenhum log ainda.</p>
    </div>
  <% end %>
</div>
