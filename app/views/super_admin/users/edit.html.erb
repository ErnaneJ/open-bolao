<% content_for :title, "Editar — #{@user.display_name}" %>
<div class="p-6 max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@user.display_name}", super_admin_user_path(@user), class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold">Editar Usuário</h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <%= render "shared/error_messages", object: @user %>
    <%= form_with model: [:super_admin, @user] do |f| %>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nome</label>
          <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email</label>
          <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Role</label>
          <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] }, {}, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <%= link_to "Cancelar", super_admin_user_path(@user), class: "px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm" %>
        <%= f.submit "Salvar", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>
