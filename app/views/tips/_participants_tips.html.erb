<%
  is_locked    = pool.tips_locked_for?(match)
  visible_tips = participant_tips_by_match[match.id] || []
%>
<% if is_locked && visible_tips.any? %>
  <div class="px-4 pb-3 pt-0">
    <p class="text-[10px] font-bold uppercase tracking-widest text-pitch-400 mb-2">Palpites</p>
    <div class="flex flex-wrap gap-1.5">
      <% visible_tips.sort_by { |t| -t.points_earned.to_i }.each do |t| %>
        <div class="flex items-center gap-1.5 bg-pitch-50 dark:bg-pitch-700/50 rounded-lg px-2 py-1
             <%= t.user_id == current_user.id ? 'ring-1 ring-neon-400/40' : '' %>">
          <div class="avatar-sm w-5 h-5 text-[9px]"><%= t.user.display_name.first.upcase %></div>
          <span class="font-mono text-xs font-bold text-pitch-900 dark:text-white">
            <%= t.home_score_tip %>–<%= t.away_score_tip %>
          </span>
          <% if t.scored? && t.points_earned.to_i > 0 %>
            <span class="text-[10px] text-neon-600 dark:text-neon-300 font-bold">+<%= t.points_earned %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
