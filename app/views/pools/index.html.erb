<% content_for :title, "Bolões" %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
  <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
    <div>
      <h1 class="font-display font-bold text-2xl text-pitch-900 dark:text-white">Bolões</h1>
      <p class="text-sm text-pitch-400 mt-0.5">Encontre um bolão ou entre com código.</p>
    </div>
    <div class="relative" data-controller="dropdown">
      <button data-action="click->dropdown#toggle"
              class="btn btn-ghost gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
        Entrar por código
      </button>
      <div data-dropdown-target="menu"
           class="hidden absolute right-0 mt-2 w-72 card shadow-xl shadow-pitch-900/10 dark:shadow-black/40 p-4 z-50 animate-enter">
        <%= form_with url: pools_path, method: :get, local: true do |f| %>
          <p class="text-xs font-semibold text-pitch-500 dark:text-pitch-400 uppercase tracking-widest mb-3">Código do bolão</p>
          <%= f.text_field :invite_code,
                placeholder: "Ex: H98WAWRT",
                class: "form-input mb-3 font-mono tracking-widest uppercase" %>
          <%= f.submit "Entrar no bolão",
                class: "w-full btn btn-neon justify-center cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @pools.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @pools.each_with_index do |pool, i| %>
        <%= render "pools/pool_card", pool: pool, index: i %>
      <% end %>
    </div>
    <div class="mt-6"><%= render "shared/pagy", pagy: @pagy %></div>
  <% else %>
    <div class="card p-16 text-center">
      <div class="text-5xl mb-4">🏟️</div>
      <p class="font-display font-bold text-lg text-pitch-900 dark:text-white mb-2">Nenhum bolão público disponível</p>
      <p class="text-sm text-pitch-400">Peça um convite ou aguarde a criação de novos bolões.</p>
    </div>
  <% end %>
</div>
