<%# Landing page — no pt-16 on main, full bleed %>
<% content_for :title, "#{t('app.name')} — Bolão de Futebol Copa do Mundo 2026" %>
<% content_for :meta_description, "Crie bolões de futebol grátis, convide amigos e dispute palpites da Copa do Mundo 2026 em tempo real. Ranking automático, múltiplos bolões e notificações." %>
<% content_for :og_image_url, "#{request.base_url}#{og_home_path}" %>
<% content_for :og_url, root_url %>

<%# Hero %>
<section class="relative min-h-screen flex flex-col overflow-hidden bg-pitch-950">
  <%# Background texture %>
  <div class="absolute inset-0 pitch-pattern opacity-40 pointer-events-none"></div>
  <div class="absolute inset-0 pointer-events-none"
       style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(184,255,60,0.07) 0%, transparent 60%)"></div>

  <%# Minimal top nav %>
  <header class="relative z-10 flex items-center justify-between px-6 sm:px-10 py-5">
    <div class="flex items-center gap-2">
      <span class="w-8 h-8 rounded-lg bg-neon-400 flex items-center justify-center text-pitch-900 text-sm font-display font-bold">B</span>
      <span class="font-display font-bold text-lg text-white tracking-tight">Open<span class="text-neon-400">Bolão</span></span>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to new_user_session_path, class: "text-sm text-pitch-200 hover:text-white transition-colors font-medium" do %>Entrar<% end %>
      <%= link_to new_user_registration_path, class: "btn btn-neon btn-sm" do %>Criar conta<% end %>
    </div>
  </header>

  <%# Hero content %>
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center px-6 pb-20 pt-10">

    <%# Eyebrow %>
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-neon-400/30 bg-neon-400/8 mb-8 animate-enter">
      <span class="w-1.5 h-1.5 rounded-full bg-neon-400 animate-pulse"></span>
      <span class="text-xs font-semibold text-neon-300 tracking-widest uppercase">Copa do Mundo 2026</span>
    </div>

    <%# Main headline %>
    <h1 class="font-display font-bold text-white leading-none tracking-tight mb-6 animate-enter stagger-1"
        style="font-size: clamp(3.5rem, 12vw, 8rem);">
      BOLÃO
      <br>
      <span class="text-gradient-neon">ONLINE</span>
    </h1>

    <p class="text-lg sm:text-xl text-pitch-300 max-w-lg mb-10 animate-enter stagger-2">
      Crie bolões, convide amigos e dispute o melhor palpite da Copa do Mundo 2026.
    </p>

    <%# CTA buttons %>
    <div class="flex flex-col sm:flex-row items-center gap-3 animate-enter stagger-3">
      <%= link_to new_user_registration_path, class: "btn btn-neon btn-lg w-full sm:w-auto" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Criar bolão grátis
      <% end %>
      <%= link_to new_user_session_path, class: "btn btn-ghost btn-lg border-pitch-600 text-pitch-200 hover:bg-pitch-800 w-full sm:w-auto" do %>
        Já tenho conta
      <% end %>
    </div>

    <%# Live score preview card %>
    <div class="mt-16 animate-enter stagger-4">
      <div class="inline-flex flex-col items-center rounded-2xl border border-pitch-700 bg-pitch-900/80 backdrop-blur-sm px-8 py-5 shadow-2xl">
        <span class="text-[10px] font-bold uppercase tracking-widest text-pitch-500 mb-3">Palpite ao vivo</span>
        <div class="flex items-center gap-6">
          <div class="text-center">
            <div class="w-10 h-10 rounded-full bg-pitch-700 flex items-center justify-center text-lg mb-1">🇧🇷</div>
            <span class="text-xs font-semibold text-pitch-300">BRA</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono font-bold text-4xl text-white" style="font-family: var(--font-mono)">2</span>
            <span class="text-pitch-500 font-bold text-xl">×</span>
            <span class="font-mono font-bold text-4xl text-white" style="font-family: var(--font-mono)">1</span>
          </div>
          <div class="text-center">
            <div class="w-10 h-10 rounded-full bg-pitch-700 flex items-center justify-center text-lg mb-1">🇲🇦</div>
            <span class="text-xs font-semibold text-pitch-300">MAR</span>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          <span class="text-xs text-red-400 font-semibold">Ao vivo · 67'</span>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Features section %>
<section class="bg-white dark:bg-pitch-900 py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-pitch-900 dark:text-white mb-3">
        Tudo que você precisa
      </h2>
      <p class="text-pitch-400 dark:text-pitch-300 max-w-md mx-auto">
        Do palpite ao ranking, tudo em tempo real com suporte a múltiplos torneios.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% [
        { icon: "⚽", title: "Palpites em tempo real", desc: "Faça seus palpites antes do jogo e acompanhe o ranking atualizado automaticamente.", color: "neon" },
        { icon: "🏆", title: "Múltiplos bolões", desc: "Crie bolões por torneio completo ou jogo avulso. Convide amigos com link ou QR code.", color: "grass" },
        { icon: "📊", title: "Ranking automático", desc: "Placar exato, vencedor correto, gol de diferença — pontuações configuráveis por bolão.", color: "amber" },
        { icon: "🔔", title: "Notificações", desc: "Avisamos quando um jogo está prestes a começar e quando seus palpites foram pontuados.", color: "neon" },
        { icon: "🔗", title: "Webhooks", desc: "Integre com outros sistemas via webhooks com assinatura HMAC e retry automático.", color: "grass" },
        { icon: "🌐", title: "API integrada", desc: "Sincronização automática com a API da Copa do Mundo 2026 em tempo real.", color: "amber" }
      ].each_with_index do |f, i| %>
        <div class="card p-6 animate-enter" style="animation-delay: <%= (i * 0.07).round(2) %>s">
          <div class="text-3xl mb-4"><%= f[:icon] %></div>
          <h3 class="font-display font-bold text-base text-pitch-900 dark:text-white mb-2"><%= f[:title] %></h3>
          <p class="text-sm text-pitch-500 dark:text-pitch-300 leading-relaxed"><%= f[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# CTA banner %>
<section class="bg-pitch-950 py-20 px-6 text-center relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none"
       style="background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(184,255,60,0.06) 0%, transparent 70%)"></div>
  <div class="relative z-10 max-w-xl mx-auto">
    <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-4">Pronto para jogar?</h2>
    <p class="text-pitch-300 mb-8">Cadastre-se gratuitamente e crie seu primeiro bolão em menos de 2 minutos.</p>
    <%= link_to new_user_registration_path, class: "btn btn-neon btn-lg" do %>
      Criar minha conta grátis
    <% end %>
  </div>
</section>

<%# Footer %>
<footer class="bg-pitch-950 border-t border-pitch-800 py-8 px-6 text-center">
  <p class="text-xs text-pitch-500">
    © <%= Date.current.year %> OpenBolão · Open Source ·
    <span class="text-pitch-400">Feito com ⚽ e Ruby on Rails</span>
  </p>
</footer>
