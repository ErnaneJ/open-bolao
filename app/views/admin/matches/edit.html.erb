<% content_for :title, "Resultado — #{@match.home_team.name} × #{@match.away_team.name}" %>
<div class="p-6 max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Jogos", admin_pool_matches_path(@pool), class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold">Inserir Resultado</h1>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <div class="text-center mb-6">
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        <%= @match.home_team.name %> × <%= @match.away_team.name %>
      </p>
      <% if @match.scheduled_at %>
        <p class="text-sm text-gray-500"><%= l(@match.scheduled_at, format: :default) %></p>
      <% end %>
    </div>

    <%= form_with model: [:admin, @pool, @match] do |f| %>
      <div class="grid grid-cols-3 gap-4 mb-4 items-center">
        <div class="text-center">
          <p class="text-sm font-medium mb-2"><%= @match.home_team.name %></p>
          <%= f.number_field :home_score, min: 0, max: 99, step: 1, value: @match.home_score,
              class: "w-20 text-center text-2xl font-bold px-3 py-2 border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 mx-auto block" %>
        </div>
        <div class="text-center text-2xl text-gray-300 font-bold">×</div>
        <div class="text-center">
          <p class="text-sm font-medium mb-2"><%= @match.away_team.name %></p>
          <%= f.number_field :away_score, min: 0, max: 99, step: 1, value: @match.away_score,
              class: "w-20 text-center text-2xl font-bold px-3 py-2 border-2 border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 mx-auto block" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Status</label>
          <%= f.select :status, Match.statuses.keys.map { |s| [s.humanize, s] },
              { selected: @match.status },
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Local</label>
          <%= f.text_field :venue, value: @match.venue, placeholder: "Estádio",
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-4">
        <%= link_to "Cancelar", admin_pool_matches_path(@pool), class: "px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm" %>
        <%= f.submit "Salvar Resultado", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
