<% day_open = default_open && day_matches.any? { |m| !m.status_finished? && !m.status_cancelled? } %>

<details <%= day_open ? "open" : "" %> class="group/day">
  <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden [&::marker]:hidden">
    <div class="flex items-center gap-4 mb-4">
      <div class="shrink-0 text-center bg-pitch-900 dark:bg-pitch-700 text-white rounded-2xl w-14 py-2">
        <div class="text-[9px] uppercase tracking-widest font-bold opacity-60 leading-tight">
          <%= date ? I18n.l(date, format: "%b") : "?" %>
        </div>
        <div class="font-display font-bold text-2xl leading-none">
          <%= date ? date.day : "?" %>
        </div>
      </div>
      <div class="flex-1">
        <p class="font-semibold text-pitch-800 dark:text-pitch-100 text-sm">
          <%= date ? I18n.l(date, format: :long) : "Sem data" %>
        </p>
        <p class="text-[11px] text-pitch-400 mt-0.5">
          <%= day_matches.size %> jogo<%= day_matches.size > 1 ? "s" : "" %>
        </p>
      </div>
      <svg class="w-4 h-4 text-pitch-400 shrink-0 transition-transform duration-200 group-open/day:rotate-180"
           fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </summary>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <% day_matches.sort_by { |m| m.scheduled_at || Time::INFINITY }.each do |match| %>
      <% tip = tips_map[match.id] %>
      <%= turbo_frame_tag "tip_#{match.id}" do %>
        <%= render "tips/tip", match: match, tip: tip, pool: pool,
              participant_tips_by_match: participant_tips_by_match,
              tip_counts_by_match: tip_counts_by_match,
              is_next: (match == next_match) %>
      <% end %>
    <% end %>
  </div>
</details>
