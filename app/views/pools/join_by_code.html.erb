<% content_for :title, "#{@pool.name} — Você foi convidado!" %>
<% content_for :meta_description, "#{@pool.admin.display_name} te convidou para participar do bolão \"#{@pool.name}\". #{@pool.pool_participants.active.count} participante#{'s' if @pool.pool_participants.active.count != 1} já entraram. Aceite o convite e faça seus palpites!" %>
<% content_for :og_url, join_pool_by_code_url(invite_code: @pool.invite_code) %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md animate-enter">

    <div class="card p-8 text-center">
      <div class="w-16 h-16 rounded-2xl bg-neon-400/10 border-2 border-neon-400/30 flex items-center justify-center text-3xl mx-auto mb-6">
        ⚽
      </div>

      <p class="text-xs font-bold uppercase tracking-widest text-pitch-400 mb-2">Você foi convidado para</p>
      <h1 class="font-display font-bold text-2xl text-pitch-900 dark:text-white mb-2"><%= @pool.name %></h1>

      <% if @pool.description.present? %>
        <p class="text-sm text-pitch-500 dark:text-pitch-300 mb-4"><%= @pool.description %></p>
      <% end %>

      <div class="flex items-center justify-center gap-6 py-4 border-y border-pitch-100 dark:border-pitch-700 mb-6">
        <div class="text-center">
          <p class="font-display font-bold text-2xl text-pitch-900 dark:text-white">
            <%= @pool.pool_participants.active.count %>
          </p>
          <p class="text-xs text-pitch-400 uppercase tracking-wide">participantes</p>
        </div>
        <div class="text-center">
          <p class="font-display font-bold text-2xl text-pitch-900 dark:text-white">
            <%= @pool.pool_scope_tournament? ? "Torneio" : "Jogo" %>
          </p>
          <p class="text-xs text-pitch-400 uppercase tracking-wide">tipo</p>
        </div>
        <div class="text-center">
          <span class="<%= @pool.status_open? ? 'badge-active' : 'badge-finished' %> text-xs">
            <%= I18n.t("activerecord.attributes.pool.statuses.#{@pool.status}", default: @pool.status) %>
          </span>
          <p class="text-xs text-pitch-400 uppercase tracking-wide mt-1">status</p>
        </div>
      </div>

      <%= form_with url: accept_pool_invite_path(invite_code: @pool.invite_code), method: :post do %>
        <%= submit_tag "Entrar no bolão", class: "w-full btn btn-neon btn-lg justify-center cursor-pointer" %>
      <% end %>

      <p class="text-xs text-pitch-400 mt-4">
        Admin: <span class="font-medium text-pitch-600 dark:text-pitch-300"><%= @pool.admin.display_name %></span>
      </p>
    </div>
  </div>
</div>
