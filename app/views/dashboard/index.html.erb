<% content_for :title, t("dashboard.title") %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold mb-6"><%= t("dashboard.title") %></h1>

  <%# Bolões ativos %>
  <section class="mb-8">
    <h2 class="text-lg font-semibold mb-4"><%= t("dashboard.my_pools") %></h2>
    <% if @participations.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @participations.each do |participation| %>
          <%= render "dashboard/pool_card", participation: participation %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-8 text-center border border-gray-200 dark:border-gray-700">
        <p class="text-gray-500 dark:text-gray-400 mb-4"><%= t("dashboard.no_pools") %></p>
        <%= link_to t("dashboard.find_pool"), pools_path, class: "text-indigo-600 hover:underline" %>
      </div>
    <% end %>
  </section>

  <%# Próximos palpites %>
  <% if @upcoming_matches.any? %>
    <section class="mb-8">
      <h2 class="text-lg font-semibold mb-4"><%= t("dashboard.upcoming_tips") %></h2>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
        <% @upcoming_matches.each do |match| %>
          <div class="px-4 py-3 flex items-center justify-between">
            <span class="text-sm font-medium">
              <%= match.home_team.name %> × <%= match.away_team.name %>
            </span>
            <span class="text-xs text-gray-500">
              <%= l(match.scheduled_at, format: :short) if match.scheduled_at %>
            </span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
