<%= turbo_frame_tag "pool_drawer_frame" do %>
  <div class="p-5">
    <%= render "shared/error_messages", object: @pool %>

    <%= form_with model: @pool, url: my_pools_path,
                  data: { controller: "pool-form" } do |f| %>
      <div class="space-y-4">

        <%# Tipo de bolão %>
        <div>
          <label class="form-label"><%= t("pools.fields.type") %></label>
          <div class="grid grid-cols-2 gap-2">
            <label class="cursor-pointer">
              <%= f.radio_button :pool_scope, "tournament",
                    class: "sr-only peer",
                    checked: @pool.pool_scope_tournament? || @pool.pool_scope.nil?,
                    data: { action: "change->pool-form#scopeChanged" } %>
              <div class="peer-checked:border-neon-400 peer-checked:bg-neon-400/5 border-2 border-pitch-200 dark:border-pitch-600 rounded-xl p-3 text-center transition-colors">
                <div class="text-xl mb-1">🏆</div>
                <p class="text-xs font-semibold text-pitch-900 dark:text-white"><%= t("pools.scope.tournament") %></p>
                <p class="text-[10px] text-pitch-400 leading-tight mt-0.5"><%= t("pools.scope.tournament_desc") %></p>
              </div>
            </label>
            <label class="cursor-pointer">
              <%= f.radio_button :pool_scope, "single_match",
                    class: "sr-only peer",
                    checked: @pool.pool_scope_single_match?,
                    data: { action: "change->pool-form#scopeChanged" } %>
              <div class="peer-checked:border-neon-400 peer-checked:bg-neon-400/5 border-2 border-pitch-200 dark:border-pitch-600 rounded-xl p-3 text-center transition-colors">
                <div class="text-xl mb-1">⚽</div>
                <p class="text-xs font-semibold text-pitch-900 dark:text-white"><%= t("pools.scope.single_match") %></p>
                <p class="text-[10px] text-pitch-400 leading-tight mt-0.5"><%= t("pools.scope.single_match_desc") %></p>
              </div>
            </label>
          </div>
        </div>

        <%# Torneio %>
        <div data-pool-form-target="tournamentField"
             class="<%= @pool.pool_scope_single_match? ? 'hidden' : '' %>">
          <label class="form-label"><%= t("pools.fields.tournament") %></label>
          <%= f.collection_select :tournament_id, @tournaments, :id, :name,
                { include_blank: t("pools.fields.tournament_placeholder") },
                class: "form-input" %>
        </div>

        <%# Jogo avulso %>
        <div data-pool-form-target="matchField"
             class="<%= @pool.pool_scope_tournament? || @pool.pool_scope.nil? ? 'hidden' : '' %>">
          <label class="form-label">Jogo</label>
          <input type="text" placeholder="Buscar time ou jogo..."
                 class="form-input mb-2"
                 data-action="input->pool-form#searchMatches"
                 data-pool-form-target="matchSearch"
                 autocomplete="off">
          <div data-pool-form-target="matchResults" class="space-y-1 max-h-40 overflow-y-auto"></div>
          <%= f.hidden_field :match_id, data: { pool_form_target: "matchId" } %>
          <div data-pool-form-target="selectedMatch" class="<%= @pool.match_id.present? ? '' : 'hidden' %> text-sm text-neon-600 dark:text-neon-300 font-medium mt-1"></div>
        </div>

        <%# Nome %>
        <div>
          <label class="form-label"><%= t("pools.fields.name") %></label>
          <%= f.text_field :name, class: "form-input",
                placeholder: t("pools.fields.name_placeholder") %>
        </div>

        <%# Descrição %>
        <div>
          <label class="form-label"><%= t("pools.fields.description") %></label>
          <%= f.text_area :description, rows: 2, class: "form-input resize-none",
                placeholder: t("pools.fields.description_placeholder") %>
        </div>

        <%# Configurações básicas %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="form-label"><%= t("pools.fields.lock_before") %></label>
            <%= f.number_field :lock_before_minutes, min: 5, max: 1440, class: "form-input" %>
            <p class="text-[10px] text-pitch-400 mt-1"><%= t("pools.fields.lock_before_hint") %></p>
          </div>
          <div>
            <label class="form-label"><%= t("pools.fields.timezone") %></label>
            <%= f.select :timezone,
                  ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] },
                  { selected: @pool.timezone || "America/Sao_Paulo" },
                  class: "form-input" %>
          </div>
        </div>

        <%# Pontuação — compacto %>
        <div class="border-t border-pitch-100 dark:border-pitch-700 pt-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-pitch-400 mb-3">Pontuação por acerto</p>
          <div class="space-y-1">
            <% Pool::SCORING_DEFAULTS.each do |key, default_val| %>
              <div class="flex items-center justify-between gap-3 py-2 border-b border-pitch-100 dark:border-pitch-700/50">
                <span class="text-sm text-pitch-700 dark:text-pitch-200">
                  <%= I18n.t("scoring.#{key}.label", default: key.to_s.humanize) %>
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                  <input type="number" name="pool[scoring_config][<%= key %>]"
                         min="0" max="100"
                         value="<%= (@pool.scoring_config || {})[key.to_s] || default_val %>"
                         class="form-input w-14 text-center font-mono font-bold py-1.5 px-2">
                  <span class="text-xs text-pitch-400">pts</span>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# Ações %>
        <div class="flex items-center justify-end gap-3 pt-2 border-t border-pitch-100 dark:border-pitch-700">
          <%# Cancel: navigate top-level to dashboard (closes drawer naturally) %>
          <%= link_to "Cancelar", dashboard_path,
                class: "btn btn-ghost",
                data: { turbo_frame: "_top" } %>
          <%= f.submit t("pools.new.create_btn"), class: "btn btn-neon cursor-pointer" %>
        </div>

      </div>
    <% end %>
  </div>
<% end %>
