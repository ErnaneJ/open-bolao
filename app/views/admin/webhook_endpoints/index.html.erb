<% content_for :title, "Webhooks — #{@pool.name}" %>

<div class="p-6">
  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <%= link_to "← #{@pool.name}", admin_pool_path(@pool),
          class: "text-sm text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200" %>
    <h1 class="font-display font-bold text-2xl text-pitch-900 dark:text-white flex-1 mx-4">Webhooks</h1>
    <%= link_to "Novo endpoint", new_admin_pool_webhook_endpoint_path(@pool), class: "btn btn-neon btn-sm" %>
  </div>

  <% if @endpoints.any? %>
    <div class="space-y-4">
      <% @endpoints.each do |endpoint| %>
        <div class="card p-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">

            <%# Info -%>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="<%= endpoint.active? ? 'text-grass-500' : 'text-pitch-300' %> shrink-0">
                  <svg class="w-2 h-2 fill-current inline" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
                </span>
                <%# HTTP method badge -%>
                <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded
                             <%= endpoint.http_method == 'GET' ? 'bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300' : 'bg-neon-100 dark:bg-neon-900/40 text-neon-700 dark:text-neon-300' %>">
                  <%= endpoint.http_method %>
                </span>
                <code class="text-sm font-medium text-pitch-900 dark:text-white truncate max-w-[320px]"><%= endpoint.url %></code>
              </div>

              <%# Eventos -%>
              <div class="flex flex-wrap gap-1 mt-1 mb-2">
                <% endpoint.events.each do |event| %>
                  <span class="badge badge-draft text-[10px]"><%= event %></span>
                <% end %>
              </div>

              <% if endpoint.last_triggered_at %>
                <p class="text-xs text-pitch-400">
                  Último disparo: <%= time_ago_in_words(endpoint.last_triggered_at) %> atrás
                  <% if endpoint.last_response_code %>
                    · HTTP
                    <span class="font-mono font-bold <%= endpoint.last_response_code.to_s.start_with?('2') ? 'text-grass-500' : 'text-red-500' %>">
                      <%= endpoint.last_response_code %>
                    </span>
                  <% end %>
                </p>
              <% end %>
            </div>

            <%# Ações -%>
            <div class="flex flex-col gap-1 shrink-0">
              <%# Botão de teste por evento -%>
              <div class="flex flex-wrap gap-1 justify-end mb-1">
                <% endpoint.events.each do |event| %>
                  <%= button_to test_admin_pool_webhook_endpoint_path(@pool, endpoint),
                        method: :post,
                        params: { event_type: event },
                        class: "text-[10px] px-2 py-1 rounded border border-pitch-200 dark:border-pitch-600 hover:bg-pitch-50 dark:hover:bg-pitch-700 font-mono transition-colors" do %>
                    Testar <span class="text-neon-600 dark:text-neon-300"><%= event %></span>
                  <% end %>
                <% end %>
              </div>
              <div class="flex items-center gap-2 justify-end">
                <%= link_to "Editar", edit_admin_pool_webhook_endpoint_path(@pool, endpoint),
                      class: "text-xs text-pitch-500 hover:text-pitch-800 dark:hover:text-white" %>
                <%= button_to "Excluir", admin_pool_webhook_endpoint_path(@pool, endpoint),
                      method: :delete,
                      data: { turbo_confirm: "Excluir este webhook?" },
                      class: "text-xs text-red-500 hover:text-red-700" %>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card p-12 text-center">
      <p class="text-pitch-400 mb-4">Nenhum webhook configurado ainda.</p>
      <%= link_to "Criar primeiro endpoint", new_admin_pool_webhook_endpoint_path(@pool), class: "btn btn-neon btn-sm" %>
    </div>
  <% end %>
</div>
