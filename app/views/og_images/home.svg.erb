<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <style>@import url('https://fonts.googleapis.com/css2?family=Syne:wght@800&amp;family=DM+Sans:wght@400;500&amp;display=swap');</style>
    <radialGradient id="topglow" cx="50%" cy="-5%" rx="70%" ry="60%">
      <stop offset="0%" stop-color="#b8ff3c" stop-opacity="0.10"/>
      <stop offset="100%" stop-color="#b8ff3c" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="bottomglow" cx="50%" cy="110%" rx="60%" ry="50%">
      <stop offset="0%" stop-color="#243460" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#243460" stop-opacity="0"/>
    </radialGradient>
    <!-- Subtle grid lines -->
    <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
      <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#ffffff" stroke-width="0.5" stroke-opacity="0.025"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="#04091a"/>
  <rect width="1200" height="630" fill="url(#grid)"/>
  <ellipse cx="600" cy="-30" rx="780" ry="430" fill="url(#topglow)"/>
  <ellipse cx="600" cy="700" rx="600" ry="340" fill="url(#bottomglow)"/>

  <!-- Top pill label -->
  <rect x="456" y="68" width="288" height="38" rx="19" fill="#0c152e" stroke="#b8ff3c" stroke-width="1.2" stroke-opacity="0.35"/>
  <circle cx="478" cy="87" r="5" fill="#b8ff3c"/>
  <text x="492" y="92" font-family="'DM Sans', sans-serif" font-size="12" font-weight="600" fill="#b8ff3c" opacity="0.95" letter-spacing="3.5">COPA DO MUNDO 2026</text>

  <!-- BOLÃO -->
  <text x="600" y="298"
        font-family="'Syne', sans-serif"
        font-size="155" font-weight="800"
        fill="#ffffff"
        text-anchor="middle"
        letter-spacing="-3">BOL&#xC3;O</text>

  <!-- ONLINE in neon -->
  <text x="600" y="447"
        font-family="'Syne', sans-serif"
        font-size="155" font-weight="800"
        fill="#b8ff3c"
        text-anchor="middle"
        letter-spacing="-3">ONLINE</text>

  <!-- Subtitle -->
  <text x="600" y="516"
        font-family="'DM Sans', sans-serif"
        font-size="19" font-weight="400"
        fill="#5a74a8"
        text-anchor="middle">Crie bol&#xF5;es, convide amigos e dispute o melhor palpite da Copa do Mundo 2026.</text>

  <!-- Bottom branding -->
  <rect x="547" y="566" width="106" height="32" rx="16" fill="#b8ff3c"/>
  <text x="600" y="587"
        font-family="'Syne', sans-serif"
        font-size="14" font-weight="800"
        fill="#04091a"
        text-anchor="middle">OpenBol&#xE3;o</text>
</svg>
