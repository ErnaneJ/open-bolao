<div class="space-y-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">URL do endpoint</label>
    <%= f.url_field :url, placeholder: "https://seu-servidor.com/webhook", class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Eventos</label>
    <div class="grid grid-cols-2 gap-2">
      <% %w[goal match_finished rank_changed pool_finished pool_invite test].each do |event| %>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="webhook_endpoint[events][]" value="<%= event %>"
                 <%= endpoint.events&.include?(event) ? "checked" : "" %>
                 class="rounded border-gray-300 text-indigo-600">
          <span class="text-sm"><%= event.humanize %></span>
        </label>
      <% end %>
    </div>
  </div>
  <div class="flex items-center justify-between">
    <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Ativo</label>
    <%= f.check_box :active, class: "rounded border-gray-300 text-indigo-600" %>
  </div>
</div>
