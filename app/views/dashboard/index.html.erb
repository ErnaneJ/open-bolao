<% content_for :title, t("dashboard.title") %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8"
     data-controller="modal">

  <%# Modal de criação de bolão %>
  <dialog data-modal-target="dialog"
          data-action="click->modal#backdropClick"
          class="dark:bg-pitch-800">
    <%= turbo_frame_tag "new_pool_modal" do %>
      <%= render "shared/loading_spinner" %>
    <% end %>
  </dialog>

  <%# Header %>
  <div class="mb-8 flex items-start justify-between gap-4 flex-wrap animate-enter">
    <div>
      <p class="text-sm text-pitch-400 mb-1 font-medium uppercase tracking-widest">
        <%= t("dashboard.welcome_back") %>
      </p>
      <h1 class="font-display font-bold text-3xl text-pitch-900 dark:text-white">
        <%= current_user.display_name.split.first %>
      </h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to admin_pools_path, class: "btn btn-ghost btn-sm" do %>
        <%= t("dashboard.my_pools_admin") %>
      <% end %>
      <%= link_to new_my_pool_path,
            class: "btn btn-neon btn-sm",
            data: { action: "click->modal#open", turbo_frame: "new_pool_modal" } do %>
        + <%= t("pools.new.create_btn") %>
      <% end %>
    </div>
  </div>

  <%# Ao vivo agora %>
  <% if @live_matches.any? %>
    <section class="mb-8 animate-enter stagger-1">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <h2 class="font-display font-bold text-sm uppercase tracking-widest text-red-500">
          <%= t("dashboard.live_now") %>
        </h2>
      </div>
      <div class="flex gap-3 overflow-x-auto pb-2">
        <% @live_matches.each do |m| %>
          <%= link_to match_path(m), class: "card p-3 shrink-0 w-44 hover:border-red-400/40 transition-all" do %>
            <div class="flex items-center justify-between mb-2">
              <% if m.home_team.flag_url.present? %>
                <img src="<%= m.home_team.flag_url %>" class="w-7 h-5 object-cover rounded" alt="">
              <% else %>
                <span class="text-lg">🏴</span>
              <% end %>
              <span class="font-mono font-bold text-lg text-red-500">
                <%= m.home_score %>–<%= m.away_score %>
              </span>
              <% if m.away_team.flag_url.present? %>
                <img src="<%= m.away_team.flag_url %>" class="w-7 h-5 object-cover rounded" alt="">
              <% else %>
                <span class="text-lg">🏴</span>
              <% end %>
            </div>
            <p class="text-[11px] text-pitch-500 dark:text-pitch-400 text-center truncate">
              <%= m.home_team.short_name || m.home_team.name.split.first %>
              × <%= m.away_team.short_name || m.away_team.name.split.first %>
            </p>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Meus bolões (participando) %>
  <section class="mb-8">
    <h2 class="font-display font-bold text-lg text-pitch-900 dark:text-white mb-4">
      <%= t("dashboard.my_pools") %>
    </h2>
    <% if @participations.any? || @administered_pools.any? %>
      <div id="pool-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @participations.each_with_index do |participation, i| %>
          <%= render "dashboard/pool_card", participation: participation, index: i %>
        <% end %>
        <%# Pools administered but not yet participating %>
        <% @administered_pools.each_with_index do |pool, i| %>
          <%= render "dashboard/admin_pool_card", pool: pool, index: @participations.size + i %>
        <% end %>
      </div>
    <% else %>
      <div class="card p-12 text-center">
        <div class="text-5xl mb-4">⚽</div>
        <p class="font-display font-bold text-lg text-pitch-900 dark:text-white mb-2">
          <%= t("dashboard.no_pools") %>
        </p>
        <p class="text-sm text-pitch-400 mb-6"><%= t("dashboard.no_pools_hint") %></p>
        <%= link_to new_my_pool_path,
              class: "btn btn-neon",
              data: { action: "click->modal#open", turbo_frame: "new_pool_modal" } do %>
          + <%= t("pools.new.create_btn") %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# Próximos jogos %>
  <% if @next_matches.any? %>
    <section>
      <h2 class="font-display font-bold text-lg text-pitch-900 dark:text-white mb-4">
        <%= t("dashboard.upcoming_matches") %>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <% @next_matches.each do |m| %>
          <%= link_to match_path(m),
                class: "card p-4 hover:border-neon-400/40 transition-all group" do %>
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="text-center flex-1">
                <% if m.home_team.flag_url.present? %>
                  <img src="<%= m.home_team.flag_url %>" class="w-10 h-7 object-cover rounded mx-auto mb-1" alt="">
                <% end %>
                <p class="text-xs font-semibold text-pitch-700 dark:text-pitch-200 truncate">
                  <%= m.home_team.short_name || m.home_team.name.split.first(2).join(" ") %>
                </p>
              </div>
              <div class="text-center shrink-0">
                <span class="text-pitch-400 text-sm font-bold">×</span>
              </div>
              <div class="text-center flex-1">
                <% if m.away_team.flag_url.present? %>
                  <img src="<%= m.away_team.flag_url %>" class="w-10 h-7 object-cover rounded mx-auto mb-1" alt="">
                <% end %>
                <p class="text-xs font-semibold text-pitch-700 dark:text-pitch-200 truncate">
                  <%= m.away_team.short_name || m.away_team.name.split.first(2).join(" ") %>
                </p>
              </div>
            </div>
            <p class="text-[10px] text-pitch-400 text-center font-mono">
              <%= m.scheduled_at ? l(m.scheduled_at, format: :short) : "?" %>
            </p>
            <% if m.tournament %>
              <p class="text-[10px] text-pitch-400 text-center truncate mt-0.5"><%= m.tournament.name %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
