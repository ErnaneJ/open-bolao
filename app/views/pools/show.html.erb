<% content_for :title, @pool.name %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">

  <%# Pool header %>
  <div class="card p-6 mb-6 animate-enter">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0">
        <div class="flex items-center gap-2 mb-2">
          <%= @pool.pool_scope_tournament? ?
                '<span class="badge-active text-xs">Torneio</span>'.html_safe :
                '<span class="badge-pending text-xs">Jogo único</span>'.html_safe %>
          <%= content_tag :span, @pool.status.to_s.humanize,
                class: "badge #{@pool.status_active? ? 'badge-active' : 'badge-finished'}" %>
        </div>
        <h1 class="font-display font-bold text-2xl sm:text-3xl text-pitch-900 dark:text-white leading-tight">
          <%= @pool.name %>
        </h1>
        <% if @pool.description.present? %>
          <p class="text-sm text-pitch-500 dark:text-pitch-300 mt-1.5"><%= @pool.description %></p>
        <% end %>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <% if @participant %>
          <%# User's own stats %>
          <div class="text-center px-4 py-2 rounded-xl bg-neon-400/10 dark:bg-neon-400/10 border border-neon-400/20">
            <p class="text-[10px] font-bold uppercase tracking-widest text-pitch-500 dark:text-pitch-400">Sua posição</p>
            <p class="font-display font-bold text-2xl text-pitch-900 dark:text-white leading-none">
              <%= @participant.rank ? "#{@participant.rank}º" : "—" %>
            </p>
          </div>
          <div class="text-center px-4 py-2 rounded-xl bg-pitch-50 dark:bg-pitch-700/50 border border-pitch-200 dark:border-pitch-700">
            <p class="text-[10px] font-bold uppercase tracking-widest text-pitch-500 dark:text-pitch-400">Pontos</p>
            <p class="font-display font-bold text-2xl text-pitch-900 dark:text-white leading-none">
              <%= @participant.total_points %>
            </p>
          </div>
          <%= button_to leave_pool_path(@pool), method: :delete,
                data: { turbo_confirm: t("pools.leave_confirm") },
                class: "btn btn-danger btn-sm" do %>
            Sair
          <% end %>
        <% else %>
          <%= button_to join_pool_path(@pool), class: "btn btn-neon" do %>
            Participar
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Tabs %>
  <div data-controller="tabs">
    <div class="border-b border-pitch-200 dark:border-pitch-700 mb-6">
      <nav class="-mb-px flex gap-1 overflow-x-auto">
        <% [
          ["tips",         "⚽ Palpites"],
          ["ranking",      "🏆 Ranking"],
          ["matches",      "📅 Jogos"],
          ["special_bets", "🎯 Apostas Especiais"]
        ].each_with_index do |(id, label), idx| %>
          <button data-tabs-target="tab"
                  data-action="click->tabs#show"
                  data-tab="<%= id %>"
                  class="tab-btn <%= idx == 0 ? 'tab-btn-active' : '' %> px-4">
            <%= label %>
          </button>
        <% end %>
      </nav>
    </div>

    <%# Palpites %>
    <div id="tab-tips" data-tabs-target="panel">
      <%= render "tips/match_list", pool: @pool, matches: @matches, tips_map: @tips_map %>
    </div>

    <%# Ranking %>
    <div id="tab-ranking" data-tabs-target="panel" class="hidden">
      <%= turbo_stream_from "ranking_pool_#{@pool.id}" %>
      <%= render "pools/ranking", pool: @pool, ranking: @ranking, pagy: @pagy_ranking %>
    </div>

    <%# Jogos %>
    <div id="tab-matches" data-tabs-target="panel" class="hidden">
      <%= render "pools/matches_list", matches: @matches %>
    </div>

    <%# Apostas Especiais %>
    <div id="tab-special_bets" data-tabs-target="panel" class="hidden">
      <% if @pool.pool_scope_tournament? %>
        <div class="card p-8 text-center">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="font-display font-bold text-lg text-pitch-900 dark:text-white mb-2">Apostas Especiais</h3>
          <p class="text-sm text-pitch-400 mb-4">Aposte no campeão, artilheiro e mais.</p>
          <%= link_to pool_special_bets_path(@pool), class: "btn btn-primary" do %>Ver apostas especiais<% end %>
        </div>
      <% else %>
        <div class="card p-8 text-center">
          <p class="text-pitch-400 dark:text-pitch-400 text-sm"><%= t("pools.no_special_bets_single_match") %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
