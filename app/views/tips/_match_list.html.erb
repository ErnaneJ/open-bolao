<% _next_match = local_assigns[:next_match] %>
<% matches_by_date = matches.group_by { |m| m.scheduled_at&.in_time_zone("America/Sao_Paulo")&.to_date } %>

<% if matches.empty? %>
  <div class="card p-12 text-center">
    <div class="text-4xl mb-3">📅</div>
    <p class="text-pitch-400 font-medium">Nenhum jogo disponível.</p>
  </div>
<% else %>
  <div class="space-y-8">
    <% matches_by_date.sort_by { |d, _| d || Date::Infinity }.each do |date, day_matches| %>
      <div>
        <%# Date header — same style as dashboard calendar %>
        <div class="flex items-center gap-4 mb-4">
          <div class="shrink-0 text-center bg-pitch-900 dark:bg-pitch-700 text-white rounded-2xl w-14 py-2">
            <div class="text-[9px] uppercase tracking-widest font-bold opacity-60 leading-tight">
              <%= date ? I18n.l(date, format: "%b") : "?" %>
            </div>
            <div class="font-display font-bold text-2xl leading-none">
              <%= date ? date.day : "?" %>
            </div>
          </div>
          <div>
            <p class="font-semibold text-pitch-800 dark:text-pitch-100 text-sm">
              <%= date ? I18n.l(date, format: :long) : "Sem data" %>
            </p>
            <p class="text-[11px] text-pitch-400 mt-0.5">
              <%= day_matches.size %> jogo<%= day_matches.size > 1 ? "s" : "" %>
            </p>
          </div>
        </div>

        <%# Tip cards grid %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% day_matches.sort_by { |m| m.scheduled_at || Time::INFINITY }.each do |match| %>
            <% tip = tips_map[match.id] %>
            <%= turbo_frame_tag "tip_#{match.id}" do %>
              <%= render "tips/tip", match: match, tip: tip, pool: pool,
                    participant_tips_by_match: (defined?(participant_tips_by_match) ? participant_tips_by_match : {}),
                    tip_counts_by_match: (defined?(tip_counts_by_match) ? tip_counts_by_match : {}),
                    is_next: (match == _next_match) %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
