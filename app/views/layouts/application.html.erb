<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= cookies[:dark_mode] == 'false' ? '' : 'dark' %>">
  <head>
    <title><%= content_for(:title).presence || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%
      _title       = content_for(:title).presence || t("app.name")
      _description = content_for(:meta_description).presence || "Bolão de futebol online — faça seus palpites, convide amigos e dispute o ranking da Copa do Mundo 2026."
      _og_image    = "#{request.base_url}/og.png"
      _card_type   = "summary_large_image"
      _og_url      = content_for(:og_url).presence || request.url
    %>
    <meta name="description" content="<%= _description %>">
    <meta name="theme-color" content="#070e22" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <%# Open Graph %>
    <meta property="og:type"        content="website">
    <meta property="og:site_name"   content="<%= t('app.name') %>">
    <meta property="og:url"         content="<%= _og_url %>">
    <meta property="og:title"       content="<%= _title %>">
    <meta property="og:description" content="<%= _description %>">
    <meta property="og:image"       content="<%= _og_image %>">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <%# Twitter / X %>
    <meta name="twitter:card"        content="<%= _card_type %>">
    <meta name="twitter:title"       content="<%= _title %>">
    <meta name="twitter:description" content="<%= _description %>">
    <meta name="twitter:image"       content="<%= _og_image %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen antialiased">
    <%= render "layouts/navbar" if user_signed_in? %>

    <%# Flash toasts — stacked, always above everything %>
    <%= render "shared/flash", notice: notice, alert: alert %>

    <main class="<%= user_signed_in? ? 'pt-16' : '' %>">
      <%= yield %>
    </main>
  </body>
</html>
