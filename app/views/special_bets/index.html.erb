<% content_for :title, t("special_bets.title") %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@pool.name}", pool_path(@pool), class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-2xl font-bold"><%= t("special_bets.title") %></h1>
  </div>

  <div class="space-y-4">
    <% @special_bets_config.each do |bet_type, config| %>
      <% next unless config["enabled"] %>
      <% bet = @my_bets[bet_type.to_sym] %>
      <div id="special_bet_<%= bet_type %>" class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white"><%= t("special_bets.types.#{bet_type}") %></h3>
            <p class="text-xs text-indigo-600 dark:text-indigo-400 mt-0.5"><%= config["points"] %> pts</p>
          </div>
          <%= form_with url: bet ? pool_special_bet_path(@pool, bet) : pool_special_bets_path(@pool),
                        method: bet ? :patch : :post,
                        local: false do |f| %>
            <%= f.hidden_field :bet_type, value: bet_type %>
            <% if %w[champion finalist_home finalist_away].include?(bet_type) %>
              <div class="flex items-center gap-2">
                <%= f.collection_select :team_id, @teams, :id, :name,
                    { selected: bet&.team_id, include_blank: t("special_bets.select_team") },
                    { class: "px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-700" } %>
                <%= f.submit t("special_bets.save"), class: "px-3 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
              </div>
            <% elsif bet_type == "total_goals" %>
              <div class="flex items-center gap-2">
                <%= f.number_field :integer_value, value: bet&.integer_value, min: 0, max: 999,
                    placeholder: "Ex: 140",
                    class: "w-24 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-700" %>
                <%= f.submit t("special_bets.save"), class: "px-3 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
              </div>
            <% else %>
              <div class="flex items-center gap-2">
                <%= f.text_field :player_name, value: bet&.player_name,
                    placeholder: t("special_bets.player_name_placeholder"),
                    class: "px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-700" %>
                <%= f.submit t("special_bets.save"), class: "px-3 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
