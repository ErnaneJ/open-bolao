<% content_for :title, "Config Sync — #{@pool.name}" %>
<div class="p-6 max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Sincronização", admin_pool_sync_schedule_path(@pool), class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold">Configurar Sincronização</h1>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <%= form_with model: [:admin, @pool, @schedule], url: admin_pool_sync_schedule_path(@pool), method: :patch do |f| %>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Monitoramento ativo</label>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :enabled, class: "sr-only peer" %>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
          </label>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Intervalo</label>
          <%= f.select :interval_seconds,
              [["1 minuto", 60], ["2 minutos", 120], ["5 minutos", 300], ["10 minutos", 600], ["15 minutos", 900], ["30 minutos", 1800], ["1 hora", 3600]],
              { selected: @schedule.interval_seconds },
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-gray-500 mb-1">Ativo das</label>
            <%= f.time_field :active_from, value: @schedule.active_from, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Até</label>
            <%= f.time_field :active_until, value: @schedule.active_until, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Dias ativos</label>
          <div class="flex flex-wrap gap-2">
            <% %w[Dom Seg Ter Qua Qui Sex Sáb].each_with_index do |day, idx| %>
              <label class="cursor-pointer">
                <input type="checkbox" name="sync_schedule[active_weekdays][]" value="<%= idx %>"
                       <%= (@schedule.active_weekdays || (0..6).to_a).include?(idx) ? "checked" : "" %>
                       class="sr-only peer">
                <span class="px-3 py-1 rounded-full border border-gray-300 text-xs peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600">
                  <%= day %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label class="text-sm text-gray-700 dark:text-gray-300">Só em dias com jogos</label>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= f.check_box :run_only_on_match_days, class: "sr-only peer" %>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
          </label>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Provedor de API</label>
          <%= f.collection_select :api_provider_id, @api_providers, :id, :name,
              { include_blank: "Nenhum", selected: @schedule.api_provider_id },
              class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-sm" %>
        </div>
      </div>

      <div class="flex justify-end gap-3 mt-6">
        <%= link_to "Cancelar", admin_pool_sync_schedule_path(@pool), class: "px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm" %>
        <%= f.submit "Salvar", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
