<% content_for :title, "Novo Bolão" %>
<div class="p-6 max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Bolões", admin_pools_path, class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-2xl font-bold">Novo Bolão</h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <%= form_with model: [:admin, @pool] do |f| %>
      <%= render "admin/pools/form", pool: @pool, f: f %>
      <div class="flex justify-end gap-3 mt-6">
        <%= link_to "Cancelar", admin_pools_path, class: "px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm" %>
        <%= f.submit "Criar Bolão", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
