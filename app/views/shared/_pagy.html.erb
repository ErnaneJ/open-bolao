<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-center gap-1 mt-6" aria-label="Pagination">
    <% if pagy.prev %>
      <%= link_to "←", url_for(page: pagy.prev),
            class: "px-3 py-1.5 rounded-lg border border-pitch-200 dark:border-pitch-600 hover:bg-pitch-50 dark:hover:bg-pitch-700 text-sm transition-colors" %>
    <% end %>
    <% pagy.series.each do |item| %>
      <% if item == :gap %>
        <span class="px-2 text-pitch-400">…</span>
      <% elsif item == pagy.page %>
        <span class="px-3 py-1.5 rounded-lg bg-neon-400 text-pitch-900 text-sm font-semibold"><%= item %></span>
      <% else %>
        <%= link_to item, url_for(page: item),
              class: "px-3 py-1.5 rounded-lg border border-pitch-200 dark:border-pitch-600 hover:bg-pitch-50 dark:hover:bg-pitch-700 text-sm transition-colors" %>
      <% end %>
    <% end %>
    <% if pagy.next %>
      <%= link_to "→", url_for(page: pagy.next),
            class: "px-3 py-1.5 rounded-lg border border-pitch-200 dark:border-pitch-600 hover:bg-pitch-50 dark:hover:bg-pitch-700 text-sm transition-colors" %>
    <% end %>
  </nav>
<% end %>
