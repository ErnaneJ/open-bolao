<div id="ranking-table">
  <% if ranking.any? %>
    <div class="card overflow-hidden">
      <table class="data-table">
        <thead>
          <tr>
            <th class="w-14">#</th>
            <th><%= t("ranking.player") %></th>
            <th class="text-right"><%= t("ranking.points") %></th>
            <th class="text-center w-12 hidden sm:table-cell"><%= t("ranking.trend") %></th>
          </tr>
        </thead>
        <tbody>
          <% ranking.each do |participant| %>
            <tr class="<%= 'bg-neon-400/5 dark:bg-neon-400/5' if participant.user_id == current_user.id %>">
              <td>
                <% case participant.rank
                   when 1 then %><span class="rank-1">1</span><%
                   when 2 then %><span class="rank-2">2</span><%
                   when 3 then %><span class="rank-3">3</span><%
                   else        %><span class="rank-n"><%= participant.rank %></span><%
                   end %>
              </td>
              <td>
                <div class="flex items-center gap-2.5">
                  <div class="avatar-sm bg-pitch-700 dark:bg-pitch-600 text-[11px]">
                    <%= participant.user.display_name.first.upcase %>
                  </div>
                  <div class="min-w-0">
                    <span class="font-medium text-pitch-900 dark:text-white text-sm block truncate">
                      <%= participant.user.display_name %>
                    </span>
                    <% if participant.user_id == current_user.id %>
                      <span class="text-[10px] text-neon-600 dark:text-neon-300 font-semibold">você</span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="text-right">
                <span class="font-display font-bold text-pitch-900 dark:text-white"><%= participant.total_points %></span>
                <span class="text-xs text-pitch-400 ml-0.5">pts</span>
              </td>
              <td class="text-center hidden sm:table-cell">
                <% case participant.rank_trend
                   when "up"   then %><span class="text-grass-500" title="Subindo">↑</span><%
                   when "down" then %><span class="text-red-500" title="Caindo">↓</span><%
                   else             %><span class="text-pitch-400">—</span><%
                   end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mt-4"><%= render "shared/pagy", pagy: pagy %></div>
  <% else %>
    <div class="card p-12 text-center">
      <div class="text-4xl mb-3">🏆</div>
      <p class="text-pitch-400 dark:text-pitch-400 font-medium"><%= t("ranking.empty") %></p>
    </div>
  <% end %>
</div>
