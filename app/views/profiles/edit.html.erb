<% content_for :title, "Editar Perfil" %>

<div class="max-w-lg mx-auto px-4 sm:px-6 py-8">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Perfil", profile_path, class: "text-sm text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200" %>
    <h1 class="font-display font-bold text-xl text-pitch-900 dark:text-white">Editar Perfil</h1>
  </div>

  <div class="card p-6">
    <%= render "shared/error_messages", object: @user %>

    <%= form_with model: @user, url: profile_path, method: :patch, multipart: true do |f| %>
      <div class="space-y-5">

        <%# Avatar upload %>
        <div class="flex items-center gap-5">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar,
                  class: "w-20 h-20 rounded-2xl object-cover" %>
          <% else %>
            <div class="w-20 h-20 rounded-2xl bg-pitch-900 dark:bg-pitch-600 flex items-center justify-center">
              <span class="font-display font-bold text-2xl text-white"><%= @user.display_name.first.upcase %></span>
            </div>
          <% end %>
          <div class="flex-1">
            <%= f.label :avatar, "Foto de perfil", class: "form-label" %>
            <%= f.file_field :avatar,
                  accept: "image/png,image/jpeg,image/webp",
                  class: "block w-full text-sm text-pitch-500 dark:text-pitch-400
                          file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0
                          file:text-xs file:font-semibold
                          file:bg-neon-400 file:text-pitch-900
                          hover:file:bg-neon-300 file:cursor-pointer" %>
            <p class="text-[11px] text-pitch-400 mt-1">PNG, JPG ou WEBP · máx 5 MB</p>
          </div>
        </div>

        <div>
          <%= f.label :name, "Nome", class: "form-label" %>
          <%= f.text_field :name, class: "form-input" %>
        </div>

        <div>
          <%= f.label :locale, "Idioma", class: "form-label" %>
          <%= f.select :locale,
                [["Português (BR)", "pt_br"], ["English", "en"]],
                { selected: @user.locale },
                class: "form-input" %>
        </div>

        <hr class="border-pitch-100 dark:border-pitch-700">
        <p class="text-sm font-semibold text-pitch-600 dark:text-pitch-300">Alterar senha (opcional)</p>

        <div>
          <%= f.label :current_password, "Senha atual", class: "form-label" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :password, "Nova senha", class: "form-label" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
          </div>
        </div>

        <%= f.submit "Salvar alterações", class: "w-full btn btn-primary justify-center cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
