<% content_for :title, "Editar Jogo" %>
<div class="p-6 max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Jogos", super_admin_tournament_matches_path(@tournament), class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold"><%= @match.home_team.name %> × <%= @match.away_team.name %></h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <%= form_with model: [:super_admin, @tournament, @match] do |f| %>
      <%= render "super_admin/tournament_matches/form", f: f %>
      <div class="flex justify-end gap-3 mt-6">
        <%= link_to "Cancelar", super_admin_tournament_matches_path(@tournament), class: "px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm" %>
        <%= f.submit "Salvar", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>
