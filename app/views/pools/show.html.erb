<% content_for :title, @pool.name %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Header %>
  <div class="flex items-start justify-between mb-6 flex-wrap gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= @pool.name %></h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= @pool.description %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= status_badge(@pool.status) %>
      <% if @participant %>
        <%= button_to t("pools.leave"), leave_pool_path(@pool), method: :delete, data: { turbo_confirm: t("pools.leave_confirm") }, class: "text-sm text-red-600 hover:underline" %>
      <% else %>
        <%= button_to t("pools.join"), join_pool_path(@pool), class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700" %>
      <% end %>
    </div>
  </div>

  <%# Tabs %>
  <div class="border-b border-gray-200 dark:border-gray-700 mb-6" data-controller="tabs">
    <nav class="-mb-px flex gap-6 overflow-x-auto" aria-label="Tabs">
      <% tabs = [
        ["tips",          t("pools.tabs.tips")],
        ["ranking",       t("pools.tabs.ranking")],
        ["matches",       t("pools.tabs.matches")],
        ["special_bets",  t("pools.tabs.special_bets")]
      ] %>
      <% tabs.each_with_index do |(id, label), idx| %>
        <button data-tabs-target="tab" data-action="click->tabs#show" data-tab="<%= id %>"
                class="pb-3 px-1 text-sm font-medium border-b-2 whitespace-nowrap
                       <%= idx == 0 ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %>">
          <%= label %>
        </button>
      <% end %>
    </nav>
  </div>

  <%# Tab: Palpites %>
  <div id="tab-tips" data-tabs-target="panel">
    <%= render "tips/match_list", pool: @pool, matches: @matches, tips_map: @tips_map %>
  </div>

  <%# Tab: Ranking %>
  <div id="tab-ranking" data-tabs-target="panel" class="hidden">
    <%= turbo_stream_from "ranking_pool_#{@pool.id}" %>
    <%= render "pools/ranking", pool: @pool, ranking: @ranking, pagy: @pagy_ranking %>
  </div>

  <%# Tab: Jogos %>
  <div id="tab-matches" data-tabs-target="panel" class="hidden">
    <%= render "pools/matches_list", matches: @matches %>
  </div>

  <%# Tab: Palpites Especiais %>
  <div id="tab-special_bets" data-tabs-target="panel" class="hidden">
    <% if @pool.tournament_pool? %>
      <%= link_to t("pools.go_to_special_bets"), pool_special_bets_path(@pool), class: "text-indigo-600 hover:underline text-sm" %>
    <% else %>
      <p class="text-gray-500 dark:text-gray-400 text-sm"><%= t("pools.no_special_bets_single_match") %></p>
    <% end %>
  </div>
</div>
