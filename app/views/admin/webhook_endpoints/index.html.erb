<% content_for :title, "Webhooks — #{@pool.name}" %>
<div class="p-6">
  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <%= link_to "← #{@pool.name}", admin_pool_path(@pool), class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-2xl font-bold flex-1">Webhooks</h1>
    <%= link_to "Novo endpoint", new_admin_pool_webhook_endpoint_path(@pool), class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700" %>
  </div>

  <% if @endpoints.any? %>
    <div class="space-y-3">
      <% @endpoints.each do |endpoint| %>
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <div class="w-2 h-2 rounded-full <%= endpoint.active? ? 'bg-green-500' : 'bg-gray-300' %>"></div>
                <code class="text-sm font-medium truncate"><%= endpoint.url %></code>
              </div>
              <div class="flex flex-wrap gap-1 mt-1">
                <% endpoint.events.each do |event| %>
                  <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs rounded-full"><%= event %></span>
                <% end %>
              </div>
              <% if endpoint.last_triggered_at %>
                <p class="text-xs text-gray-400 mt-1">Último disparo: <%= time_ago_in_words(endpoint.last_triggered_at) %> atrás (HTTP <%= endpoint.last_response_code %>)</p>
              <% end %>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= button_to "Testar", test_admin_pool_webhook_endpoint_path(@pool, endpoint), method: :post, class: "text-xs px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-50 dark:hover:bg-gray-700" %>
              <%= link_to "Editar", edit_admin_pool_webhook_endpoint_path(@pool, endpoint), class: "text-xs text-indigo-600 hover:underline" %>
              <%= button_to "Excluir", admin_pool_webhook_endpoint_path(@pool, endpoint), method: :delete,
                  data: { turbo_confirm: "Excluir este webhook?" }, class: "text-xs text-red-600 hover:underline" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-500">
      <p>Nenhum webhook configurado.</p>
    </div>
  <% end %>
</div>
