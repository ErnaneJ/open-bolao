<% content_for :title, t("pools.index.title") %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t("pools.index.title") %></h1>
    <div class="flex items-center gap-3">
      <%# Join by code %>
      <div data-controller="dropdown" class="relative">
        <button data-action="click->dropdown#toggle"
                class="px-4 py-2 border border-indigo-600 text-indigo-600 rounded-lg text-sm font-medium hover:bg-indigo-50 transition">
          <%= t("pools.index.enter_by_code") %>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-64 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 p-4 z-50">
          <%= form_with url: pools_path, method: :get, local: true do |f| %>
            <%= f.text_field :invite_code,
                placeholder: t("pools.index.code_placeholder"),
                class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-700 mb-2" %>
            <%= f.submit t("pools.index.enter"), class: "w-full px-3 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @pools.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @pools.each do |pool| %>
        <%= render "pools/pool_card", pool: pool %>
      <% end %>
    </div>
    <%= render "shared/pagy", pagy: @pagy %>
  <% else %>
    <div class="text-center py-16 text-gray-500 dark:text-gray-400">
      <p class="text-lg mb-2"><%= t("pools.index.no_pools") %></p>
    </div>
  <% end %>
</div>
