<% content_for :title, "Provedores de API" %>
<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Provedores de API</h1>
    <%= link_to "Novo Provedor", new_super_admin_api_provider_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700" %>
  </div>

  <% if @providers.any? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
      <% @providers.each do |provider| %>
        <div class="px-4 py-4 flex items-center justify-between gap-4 flex-wrap">
          <div>
            <div class="flex items-center gap-2 mb-0.5">
              <div class="w-2 h-2 rounded-full <%= provider.active? ? 'bg-green-500' : 'bg-gray-300' %>"></div>
              <p class="font-medium text-sm"><%= provider.name %></p>
              <span class="text-xs text-gray-400">(<%= provider.provider_type %>)</span>
            </div>
            <% if provider.base_url.present? %>
              <p class="text-xs text-gray-400 ml-4"><%= provider.base_url %></p>
            <% end %>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <%= button_to "Testar conexão", test_connection_super_admin_api_provider_path(provider), method: :post, class: "text-xs px-3 py-1 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700" %>
            <%= link_to "Editar", edit_super_admin_api_provider_path(provider), class: "text-xs text-indigo-600 hover:underline" %>
            <%= button_to "Excluir", super_admin_api_provider_path(provider), method: :delete, data: { turbo_confirm: "Excluir?" }, class: "text-xs text-red-600 hover:underline" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-500">
      <p>Nenhum provedor configurado.</p>
    </div>
  <% end %>
</div>
