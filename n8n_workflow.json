{
  "name": "Open Bolão → WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "open-bolao-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Receber Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "open-bolao-webhook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {}
      },
      "id": "node-respond-200",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-has-group",
              "leftValue": "={{ $json.body.pool_metadata?.whatsapp_group_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ]
        },
        "options": {}
      },
      "id": "node-check-group",
      "name": "Tem group ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 380]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json.body;\nconst event  = body.event;\nconst meta   = body.pool_metadata || {};\nconst match  = body.match  || {};\nconst pool   = body.pool   || {};\nconst tip    = body.tip    || {};\nconst poolName = meta.pool_name || pool.name || 'Bolão';\n\nlet text = '';\n\nswitch (event) {\n  case 'match.goal':\n    text = `⚽ *Gol!*\\n${match.home_team} *${match.home_score}* x *${match.away_score}* ${match.away_team}\\n_${poolName}_`;\n    break;\n  case 'match.live':\n    text = `🏁 *Jogo começou!*\\n${match.home_team} x ${match.away_team}\\n_${poolName}_`;\n    break;\n  case 'match.finished':\n    text = `🔔 *Jogo encerrado!*\\n${match.home_team} *${match.home_score}* x *${match.away_score}* ${match.away_team}\\n_${poolName}_`;\n    break;\n  case 'pool.ranking_updated':\n    text = `📊 *Ranking atualizado!*\\nLíder: *${body.leader || '—'}*\\n_${poolName}_`;\n    break;\n  case 'pool.finished':\n    text = `🏆 *Bolão encerrado!*\\n_${poolName}_\\nConfira o resultado final!`;\n    break;\n  case 'tip.scored':\n    text = `✅ *Palpite pontuado!*\\n${tip.user || '—'} → *${tip.points_earned || 0} pts*\\n_${poolName}_`;\n    break;\n  case 'pool.daily_matches':\n    const rows = (body.matches || []).map(m => `• ${m.home_team} x ${m.away_team}`).join('\\n');\n    text = `📅 *Jogos de hoje — ${poolName}*\\n${rows || 'Nenhum jogo hoje.'}`;\n    break;\n  default:\n    text = `📣 *${event}*\\n_${poolName}_`;\n}\n\nreturn {\n  json: {\n    whatsapp_group_id: meta.whatsapp_group_id,\n    payload: {\n      to:      meta.whatsapp_group_id,\n      message: text,\n      type:    'text'\n    }\n  }\n};"
      },
      "id": "node-build-message",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 380]
    },
    {
      "parameters": {
        "jsCode": "// Salva o payload para combinar com o token depois\nconst item = $input.first().json;\nreturn [{ json: { payload: item.payload } }];"
      },
      "id": "node-save-payload",
      "name": "Merge Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-buddy.cloudnane.com/api/auth/admin",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "email",    "value": "={{ $vars.BUDDY_EMAIL }}" },
            { "name": "password", "value": "={{ $vars.BUDDY_PASSWORD }}" }
          ]
        },
        "options": {}
      },
      "id": "node-buddy-login",
      "name": "Buddy Login - Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1120, 380]
    },
    {
      "parameters": {
        "jsCode": "// Combina o token com o payload salvo anteriormente\nconst token   = $input.first().json.token;\nconst payload = $('Merge Payloads').first().json.payload;\n\nreturn [{ json: { token, payload } }];"
      },
      "id": "node-combine-token",
      "name": "Combinar Token + Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-buddy.cloudnane.com/api/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.token }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {},
        "alwaysOutputData": true
      },
      "id": "node-send-whatsapp",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1560, 380]
    }
  ],
