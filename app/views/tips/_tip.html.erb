<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4
            <%= tip&.locked? ? 'opacity-75' : '' %>
            <%= tip&.scored? ? 'border-l-4 border-l-indigo-500' : '' %>">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <%# Match info %>
    <div class="flex items-center gap-3 min-w-0">
      <div class="text-center min-w-0">
        <p class="font-medium text-sm truncate"><%= match.home_team.name %></p>
      </div>
      <div class="text-center shrink-0">
        <% if match.status_finished? %>
          <span class="font-bold text-gray-900 dark:text-white"><%= match.home_score %> – <%= match.away_score %></span>
        <% elsif match.status_live? %>
          <span class="text-red-600 font-bold text-xs animate-pulse">AO VIVO</span>
        <% else %>
          <span class="text-xs text-gray-400"><%= match.scheduled_at ? l(match.scheduled_at, format: :short) : "—" %></span>
        <% end %>
      </div>
      <div class="text-center min-w-0">
        <p class="font-medium text-sm truncate"><%= match.away_team.name %></p>
      </div>
    </div>

    <%# Tip input or result %>
    <div class="flex items-center gap-3 shrink-0">
      <% if tip&.locked? || match.status_finished? || match.status_live? || match.status_cancelled? %>
        <%# Show saved tip or empty %>
        <div class="flex items-center gap-1 text-sm">
          <% if tip&.home_score_tip.present? %>
            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded font-mono font-bold"><%= tip.home_score_tip %></span>
            <span class="text-gray-400">×</span>
            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded font-mono font-bold"><%= tip.away_score_tip %></span>
          <% else %>
            <span class="text-xs text-gray-400 italic"><%= t("tips.no_tip") %></span>
          <% end %>
          <% if tip&.scored? %>
            <span class="ml-2 px-2 py-0.5 bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-300 text-xs font-bold rounded-full">
              +<%= tip.points_earned %>pts
            </span>
          <% end %>
        </div>
      <% else %>
        <%# Editable tip form %>
        <%= form_with url: tip ? pool_tip_path(pool, tip.match_id) : pool_tips_path(pool),
                      method: tip ? :patch : :post,
                      data: { controller: "tip", tip_target: "form" } do |f| %>
          <%= f.hidden_field :match_id, value: match.id %>
          <div class="flex items-center gap-1">
            <%= f.number_field :home_score_tip,
                value: tip&.home_score_tip,
                min: 0, max: 99, step: 1,
                placeholder: "0",
                class: "w-12 text-center px-2 py-1 border border-gray-300 dark:border-gray-600 rounded-lg font-mono font-bold text-sm bg-white dark:bg-gray-700",
                data: { action: "change->tip#autoSubmit" } %>
            <span class="text-gray-400 font-bold">×</span>
            <%= f.number_field :away_score_tip,
                value: tip&.away_score_tip,
                min: 0, max: 99, step: 1,
                placeholder: "0",
                class: "w-12 text-center px-2 py-1 border border-gray-300 dark:border-gray-600 rounded-lg font-mono font-bold text-sm bg-white dark:bg-gray-700",
                data: { action: "change->tip#autoSubmit" } %>
            <%= f.submit tip ? t("tips.update") : t("tips.save"),
                class: "px-3 py-1 bg-indigo-600 text-white rounded-lg text-xs font-medium hover:bg-indigo-700 cursor-pointer",
                data: { tip_target: "submitBtn" } %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
