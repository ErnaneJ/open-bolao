<%= turbo_stream.replace "notification_#{@notification.id}" do %>
  <div class="px-4 py-4 flex items-start gap-3 opacity-60">
    <div class="w-2 h-2 rounded-full mt-2 shrink-0 bg-gray-300"></div>
    <div class="flex-1 min-w-0">
      <p class="font-medium text-sm text-gray-900 dark:text-white"><%= @notification.title %></p>
      <p class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(@notification.created_at) %></p>
    </div>
  </div>
<% end %>
