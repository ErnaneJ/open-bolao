<%= link_to pool_path(participation.pool),
      class: "card p-5 block hover:border-neon-400/40 dark:hover:border-neon-400/30 transition-all duration-200 group animate-enter",
      style: "animation-delay: #{(index * 0.06).round(2)}s" do %>
  <%# Pool name + badge %>
  <div class="flex items-start justify-between gap-2 mb-4">
    <h3 class="font-display font-bold text-sm text-pitch-900 dark:text-white leading-tight truncate group-hover:text-neon-600 dark:group-hover:text-neon-300 transition-colors">
      <%= participation.pool.name %>
    </h3>
    <span class="<%= participation.pool.status_active? ? 'badge-active' : 'badge-finished' %> shrink-0">
      <%= I18n.t("activerecord.attributes.pool.statuses.#{participation.pool.status}", default: participation.pool.status) %>
    </span>
  </div>

  <%# Stats %>
  <div class="flex items-end gap-5">
    <div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-pitch-400 mb-0.5">Posição</p>
      <div class="flex items-baseline gap-0.5">
        <span class="font-display font-bold text-3xl text-pitch-900 dark:text-white leading-none"><%= participation.rank || "—" %></span>
        <% if participation.rank %><span class="text-sm text-pitch-400">º</span><% end %>
      </div>
    </div>
    <div>
      <p class="text-[10px] font-bold uppercase tracking-widest text-pitch-400 mb-0.5">Pontos</p>
      <span class="font-display font-bold text-xl text-pitch-900 dark:text-white leading-none"><%= participation.total_points %></span>
    </div>
    <div class="ml-auto">
      <% if participation.rank_trend_up? %>
        <span class="flex items-center gap-1 text-grass-500 text-sm font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
          Subindo
        </span>
      <% elsif participation.rank_trend_down? %>
        <span class="flex items-center gap-1 text-red-500 text-sm font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          Caindo
        </span>
      <% end %>
    </div>
  </div>

  <%# Bottom: pool type %>
  <div class="mt-4 pt-4 border-t border-pitch-100 dark:border-pitch-700/50 flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5 text-pitch-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
    <span class="text-xs text-pitch-400">
      <%= participation.pool.pool_scope_tournament? ? "Torneio" : "Jogo único" %>
      <% if participation.pool.tournament %>
        · <%= participation.pool.tournament.name %>
      <% end %>
    </span>
  </div>
<% end %>
