<%= render "shared/error_messages", object: pool %>

<div class="space-y-5">
  <% if pool.new_record? %>
    <div>
      <%= f.label :pool_scope, "Tipo de bolão", class: "form-label" %>
      <%= f.select :pool_scope,
            [["⚽ Bolão de Torneio", "tournament"], ["🎯 Bolão de Jogo Único", "single_match"]],
            {},
            class: "form-input",
            data: { controller: "pool-scope" } %>
    </div>
    <div data-pool-scope-target="tournamentFields">
      <%= f.label :tournament_id, "Torneio", class: "form-label" %>
      <%= f.collection_select :tournament_id, Tournament.all, :id, :name,
            { include_blank: "Selecionar torneio" },
            class: "form-input" %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nome do bolão", class: "form-label" %>
    <%= f.text_field :name, class: "form-input", placeholder: "Ex: Bolão Copa 2026" %>
  </div>

  <div>
    <%= f.label :description, "Descrição", class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-input", placeholder: "Opcional" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_at, "Início do bolão", class: "form-label" %>
      <%= f.datetime_local_field :starts_at, class: "form-input",
            value: pool.starts_at&.strftime("%Y-%m-%dT%H:%M") %>
    </div>
    <div>
      <%= f.label :ends_at, "Fim do bolão", class: "form-label" %>
      <%= f.datetime_local_field :ends_at, class: "form-input",
            value: pool.ends_at&.strftime("%Y-%m-%dT%H:%M") %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :visibility, "Visibilidade", class: "form-label" %>
      <%= f.select :visibility,
            [["Público", "public_pool"], ["Privado", "private_pool"], ["Somente convite", "invite_only"]],
            {},
            class: "form-input" %>
    </div>
    <div>
      <%= f.label :max_participants, "Máx. participantes", class: "form-label" %>
      <%= f.number_field :max_participants, min: 2, placeholder: "Ilimitado", class: "form-input" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :lock_before_minutes, "Travar X min antes do jogo", class: "form-label" %>
      <%= f.number_field :lock_before_minutes, min: 0, max: 1440, class: "form-input" %>
    </div>
    <div>
      <%= f.label :entry_fee, "Taxa de entrada (R$)", class: "form-label" %>
      <%= f.number_field :entry_fee, step: 0.01, min: 0, placeholder: "0,00", class: "form-input" %>
    </div>
  </div>

  <div>
    <%= f.label :prize_description, "Premiação / Prêmio", class: "form-label" %>
    <%= f.text_area :prize_description, rows: 2, class: "form-input", placeholder: "Opcional" %>
  </div>

  <%# Webhook -%>
  <details class="rounded-xl border border-pitch-200 dark:border-pitch-600">
    <summary class="px-4 py-3 text-sm font-semibold text-pitch-700 dark:text-pitch-200 cursor-pointer select-none">
      Webhooks
    </summary>
    <div class="p-4 space-y-4 border-t border-pitch-200 dark:border-pitch-600">

      <%# Master switch -%>
      <label class="flex items-center justify-between cursor-pointer">
        <div>
          <p class="text-sm font-medium text-pitch-700 dark:text-pitch-200">Ativar webhooks</p>
          <p class="text-[11px] text-pitch-400">Desabilitado por padrão. Quando desativado nenhum webhook é disparado.</p>
        </div>
        <%= f.check_box :webhook_enabled,
              class: "w-4 h-4 rounded border-pitch-300 dark:border-pitch-600 text-neon-500 focus:ring-neon-400" %>
      </label>

      <%# Metadata JSON -%>
      <div>
        <label class="form-label">Metadados (JSON)</label>
        <p class="text-[11px] text-pitch-400 mb-2">
          Enviado no campo <code class="bg-pitch-100 dark:bg-pitch-700 px-1 rounded">pool_metadata</code> de todos os webhooks deste bolão.
          Use para passar IDs de grupo WhatsApp, tokens, nomes, etc.
        </p>
        <%= f.text_area :webhook_metadata,
              rows: 5,
              class: "form-input font-mono text-xs resize-y",
              placeholder: '{"whatsapp_group_id": "120363...", "notify_goals": true}',
              value: pool.webhook_metadata.present? ? JSON.pretty_generate(pool.webhook_metadata) : "" %>
        <p class="text-[11px] text-pitch-400 mt-1">Deve ser JSON válido.</p>
      </div>

    </div>
  </details>

  <%# Scoring config %>
  <details class="rounded-xl border border-pitch-200 dark:border-pitch-600">
    <summary class="px-4 py-3 text-sm font-semibold text-pitch-700 dark:text-pitch-200 cursor-pointer select-none">
      Configuração de pontuação
    </summary>
    <div class="p-4 space-y-3 border-t border-pitch-200 dark:border-pitch-600">
      <% Pool::SCORING_DEFAULTS.each do |key, default| %>
        <div class="flex items-start justify-between gap-4 pb-3 border-b border-pitch-100 dark:border-pitch-700 last:border-0 last:pb-0">
          <div class="flex-1">
            <p class="text-sm font-medium text-pitch-700 dark:text-pitch-200">
              <%= I18n.t("scoring.#{key}.label", default: key.humanize) %>
            </p>
            <p class="text-[11px] text-pitch-400 mt-0.5">
              <%= I18n.t("scoring.#{key}.description", default: "") %>
            </p>
          </div>
          <%= f.number_field "scoring_config[#{key}]",
                value: pool.scoring_config_with_defaults[key],
                step: key.include?("multiplier") ? 0.5 : 1,
                min: key.include?("penalty") ? nil : 0,
                class: "form-input w-24 text-center shrink-0" %>
        </div>
      <% end %>
    </div>
  </details>
</div>
