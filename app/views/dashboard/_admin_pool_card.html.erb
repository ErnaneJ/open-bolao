<div class="card p-5 border-dashed animate-enter"
     style="<%= defined?(index) ? "animation-delay: #{(index * 0.06).round(2)}s" : "" %>">
  <div class="flex items-start justify-between gap-2 mb-3">
    <h3 class="font-display font-bold text-sm text-pitch-900 dark:text-white truncate"><%= pool.name %></h3>
    <span class="badge badge-draft shrink-0 text-[10px]">Seu bolão</span>
  </div>
  <p class="text-xs text-pitch-400 mb-4"><%= t("dashboard.admin_pool_hint") %></p>
  <div class="flex gap-2">
    <%= link_to pool_path(pool), class: "btn btn-ghost btn-sm flex-1 justify-center" do %>Ver bolão<% end %>
    <%= button_to join_pool_path(pool), method: :post,
          class: "btn btn-neon btn-sm flex-1 justify-center" do %>Participar<% end %>
  </div>
</div>
