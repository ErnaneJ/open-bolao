<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="<%= cookies[:dark_mode] == 'false' ? '' : 'dark' %>">
  <head>
    <title><%= content_for(:title).presence || "Super Admin — #{t('app.name')}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#070e22">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen antialiased bg-pitch-50 dark:bg-pitch-950 text-pitch-900 dark:text-pitch-50">

    <%# Top navbar %>
    <nav class="fixed top-0 left-0 right-0 z-40 h-14 border-b border-pitch-200 dark:border-pitch-800 bg-white/90 dark:bg-pitch-900/90 backdrop-blur-md">
      <div class="px-4 h-full flex items-center gap-3">
        <button data-controller="sidebar" data-action="click->sidebar#toggle"
                class="lg:hidden p-2 rounded-lg text-pitch-500 hover:bg-pitch-100 dark:hover:bg-pitch-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-md bg-neon-400 flex items-center justify-center text-pitch-900 text-[10px] font-display font-bold">SA</span>
          <span class="font-display font-bold text-base text-pitch-900 dark:text-white">
            OpenBolão <span class="text-xs font-sans font-normal text-pitch-400 ml-1">Super Admin</span>
          </span>
        </div>
        <div class="ml-auto flex items-center gap-2">
          <button data-controller="dark-mode" data-action="click->dark-mode#toggle"
                  class="p-2 rounded-lg text-pitch-500 hover:bg-pitch-100 dark:hover:bg-pitch-800">
            <svg class="hidden dark:block w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            <svg class="dark:hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          </button>
          <%= link_to dashboard_path, class: "text-xs text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200 transition-colors" do %>← Voltar ao site<% end %>
        </div>
      </div>
    </nav>

    <div class="pt-14 flex min-h-screen" data-controller="sidebar">

      <div data-sidebar-target="overlay"
           class="fixed inset-0 z-30 bg-pitch-950/60 backdrop-blur-sm lg:hidden hidden"
           data-action="click->sidebar#close"></div>

      <aside data-sidebar-target="sidebar"
             class="fixed left-0 top-14 bottom-0 z-30 w-56 bg-white dark:bg-pitch-900 border-r border-pitch-200 dark:border-pitch-800 overflow-y-auto transition-transform duration-200 -translate-x-full lg:translate-x-0">
        <nav class="p-3 space-y-0.5">
          <p class="sidebar-section">Gestão</p>
          <%= link_to super_admin_users_path, class: "sidebar-link #{request.path.start_with?('/super_admin/users') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            Usuários
          <% end %>
          <%= link_to super_admin_pools_path, class: "sidebar-link #{request.path.start_with?('/super_admin/pools') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            Todos Bolões
          <% end %>
          <%= link_to super_admin_tournaments_path, class: "sidebar-link #{request.path.start_with?('/super_admin/tournaments') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
            Torneios
          <% end %>
          <%= link_to super_admin_teams_path, class: "sidebar-link #{request.path.start_with?('/super_admin/teams') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Times
          <% end %>
          <p class="sidebar-section">Configuração</p>
          <%= link_to super_admin_api_providers_path, class: "sidebar-link #{request.path.start_with?('/super_admin/api_providers') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Provedores API
          <% end %>
          <%= link_to super_admin_webhook_endpoints_path, class: "sidebar-link #{request.path.start_with?('/super_admin/webhook') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            Webhooks
          <% end %>
          <%= link_to super_admin_settings_path, class: "sidebar-link #{request.path.start_with?('/super_admin/settings') ? 'sidebar-link-active' : ''}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Configurações
          <% end %>
          <p class="sidebar-section">Ferramentas</p>
          <%= link_to super_admin_blazer_path, class: "sidebar-link", target: "_blank" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Blazer
          <% end %>
          <%= link_to super_admin_sidekiq_web_path, class: "sidebar-link", target: "_blank" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            Sidekiq
          <% end %>
        </nav>
      </aside>

      <main class="flex-1 lg:ml-56 min-w-0 p-6">
        <% if notice %>
          <div class="flash-success rounded-xl px-4 py-3 text-sm mb-4 animate-enter"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="flash-error rounded-xl px-4 py-3 text-sm mb-4 animate-enter"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>

  </body>
</html>
