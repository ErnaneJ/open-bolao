<% content_for :title, "Novo Time" %>
<div class="p-6 max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Times", super_admin_teams_path, class: "text-sm text-gray-500 hover:text-indigo-600" %>
    <h1 class="text-xl font-bold">Novo Time</h1>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
    <%= form_with model: [:super_admin, @team] do |f| %>
      <%= render "super_admin/teams/form", f: f %>
      <div class="flex justify-end gap-3 mt-6">
        <%= link_to "Cancelar", super_admin_teams_path, class: "px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm" %>
        <%= f.submit "Criar", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm cursor-pointer hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>
