<% content_for :title, "Convite — #{@pool.name}" %>
<div class="max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@pool.name}", admin_pool_path(@pool), class: "text-sm text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200" %>
  </div>

  <div class="card p-6 text-center">
    <p class="stat-label mb-3">Código de convite</p>
    <div class="font-mono font-bold text-4xl tracking-[0.3em] text-neon-600 dark:text-neon-300 mb-6">
      <%= @pool.invite_code %>
    </div>

    <div class="bg-pitch-50 dark:bg-pitch-700/50 rounded-xl p-4 mb-6 text-left">
      <p class="form-label mb-2">Link de convite</p>
      <div class="flex items-center gap-2">
        <code class="flex-1 text-xs text-pitch-600 dark:text-pitch-300 break-all font-mono"><%= @invite_url %></code>
        <button data-controller="clipboard" data-clipboard-text-value="<%= @invite_url %>"
                data-action="click->clipboard#copy"
                class="btn btn-ghost btn-sm shrink-0">
          Copiar
        </button>
      </div>
    </div>

    <% if defined?(@qr) && @qr %>
      <div class="mb-6">
        <div class="inline-block p-4 bg-white rounded-2xl border border-pitch-100">
          <%= @qr.as_svg(offset: 0, color: "000", shape_rendering: "crispEdges", module_size: 4, standalone: true).html_safe %>
        </div>
      </div>
    <% end %>

    <%= button_to "Gerar novo código", admin_pool_invite_path(@pool), method: :patch,
          data: { turbo_confirm: "Isso vai invalidar o código atual. Continuar?" },
          class: "btn btn-danger btn-sm" %>
  </div>
</div>
