<% content_for :title, "Nova Fase — #{@tournament.name}" %>
<div class="max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← #{@tournament.name}", super_admin_tournament_path(@tournament), class: "text-sm text-pitch-500 hover:text-pitch-700 dark:hover:text-pitch-200" %>
    <h1 class="font-display font-bold text-xl text-pitch-900 dark:text-white">Nova Fase</h1>
  </div>
  <div class="card p-6">
    <%= form_with model: [:super_admin, @tournament, @stage] do |f| %>
      <%= render "super_admin/stages/form", f: f %>
      <div class="flex justify-end gap-3 mt-5 pt-4 border-t border-pitch-100 dark:border-pitch-700">
        <%= link_to "Cancelar", super_admin_tournament_path(@tournament), class: "btn btn-ghost" %>
        <%= f.submit "Criar fase", class: "btn btn-neon cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
